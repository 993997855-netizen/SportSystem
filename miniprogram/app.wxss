page {
  min-height: 100%;
  background: #f4f7f5;
  color: #17211b;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}
.brand-blue { color:#173b77; }.brand-gold { color:#d1a72f; }
.brand-hero { background:linear-gradient(145deg,#102f63,#28569a); color:#fff; }
.btn-primary { background:#173b77; }
.btn-secondary { background:#eaf0f9; color:#173b77; }
.tag { background:#eaf0f9; color:#173b77; }
.tag.gold { background:#fff6da; color:#8c6700; }
view, text, button, input, textarea, picker { box-sizing: border-box; }
.page { padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); }
.page-enter { animation: fade-up .28s ease-out both; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 10rpx 34rpx rgba(27, 69, 47, 0.06); }
.section-title { font-size: 32rpx; font-weight: 700; margin: 36rpx 0 20rpx; }
.muted { color: #7a817d; }
.small { font-size: 24rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.tag { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 18rpx; border-radius: 22rpx; background: #e9f5ee; color: #12643b; font-size: 23rpx; }
.tag.warning { background: #fff2de; color: #a75b00; }
.tag.danger { background: #fdebea; color: #bd352f; }
.btn-primary, .btn-secondary { border: 0; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; line-height: 88rpx; transition: transform .12s ease, opacity .12s ease, background-color .12s ease; }
.btn-primary { background: #12643b; color: #fff; }
.btn-secondary { background: #e9f5ee; color: #12643b; }
.btn-primary::after, .btn-secondary::after { border: 0; }
.btn-primary:active, .btn-secondary:active, .pressable:active { transform: scale(.98); opacity: .88; }
.btn-primary[disabled], .btn-secondary[disabled] { opacity: .52; }
.field { margin-bottom: 26rpx; }
.field-label { display: block; font-weight: 600; margin-bottom: 12rpx; }
.input, .textarea, .picker { width: 100%; min-height: 84rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #f4f7f5; border: 2rpx solid transparent; transition: border-color .15s ease, background-color .15s ease; }
.input:focus, .textarea:focus { border-color: #65a983; background: #fff; }
.textarea { min-height: 150rpx; }
.divider { height: 1rpx; background: #edf0ee; margin: 24rpx 0; }
.empty { text-align: center; color: #8a918d; padding: 80rpx 20rpx; }
.loading-state { padding: 64rpx 20rpx; text-align: center; color: #7a817d; }
.loading-dot { display: inline-block; width: 12rpx; height: 12rpx; margin: 0 7rpx; border-radius: 50%; background: #65a983; animation: pulse 1s ease-in-out infinite; }
.loading-dot:nth-child(2) { animation-delay: .14s; }.loading-dot:nth-child(3) { animation-delay: .28s; }
.error-state { margin: 28rpx; padding: 42rpx 28rpx; border-radius: 22rpx; background: #fff; text-align: center; color: #7a817d; }
.retry { display: inline-block; margin-top: 20rpx; color: #12643b; font-weight: 600; }
.sticky-action { position: sticky; bottom: 0; padding: 16rpx 0 calc(8rpx + env(safe-area-inset-bottom)); background: linear-gradient(rgba(244,247,245,0), #f4f7f5 24%); z-index: 3; }
.crm-hero { background:linear-gradient(145deg,#102f63,#28569a); color:#fff; padding:38rpx 30rpx 52rpx; border-radius:0 0 36rpx 36rpx; }
.crm-title { font-size:42rpx; font-weight:800; }.crm-sub { margin-top:10rpx; opacity:.78; font-size:24rpx; }
.metric-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18rpx; }.metric { background:#fff; border-radius:22rpx; padding:24rpx; box-shadow:0 8rpx 26rpx rgba(23,59,119,.06); }.metric-value { display:block; font-size:38rpx; font-weight:800; color:#173b77; }.metric-label { display:block; margin-top:7rpx; color:#7a817d; font-size:23rpx; }
.crm-nav-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16rpx; }.crm-nav { padding:26rpx 22rpx; border-radius:20rpx; background:#fff; }.crm-nav-title { font-weight:700; color:#173b77; }.crm-nav-sub { margin-top:8rpx; color:#8a918d; font-size:22rpx; }
.badge { display:inline-flex; padding:7rpx 14rpx; border-radius:14rpx; font-size:21rpx; background:#eaf0f9; color:#173b77; }.badge.a { background:#fdebea; color:#b72d28; }.badge.b { background:#fff2de; color:#9c5a06; }.badge.c { background:#eef1ef; color:#68706b; }.badge.public { background:#edeafa; color:#6045a5; }
.lead-name { font-size:32rpx; font-weight:800; }.lead-meta { margin-top:10rpx; line-height:1.6; }.action-row { display:flex; gap:14rpx; flex-wrap:wrap; margin-top:22rpx; }.action-chip { padding:14rpx 20rpx; border-radius:16rpx; background:#eaf0f9; color:#173b77; font-size:24rpx; }.action-chip.danger { background:#fdebea; color:#bd352f; }
.timeline { position:relative; padding-left:34rpx; margin-bottom:28rpx; }.timeline::before { content:""; position:absolute; left:9rpx; top:10rpx; bottom:-28rpx; width:2rpx; background:#dbe3ee; }.timeline:last-child::before { display:none; }.timeline-dot { position:absolute; left:0; top:8rpx; width:20rpx; height:20rpx; border-radius:50%; background:#d1a72f; border:4rpx solid #fff; }.timeline-title { font-weight:700; }.timeline-content { margin-top:8rpx; line-height:1.65; }
.score-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }.score-item { background:#f4f6fa; border-radius:16rpx; padding:20rpx; }.score-label { font-size:24rpx; margin-bottom:12rpx; }.score-options { display:flex; gap:8rpx; }.score { width:42rpx; height:42rpx; line-height:42rpx; text-align:center; border-radius:12rpx; background:#fff; color:#7a817d; }.score.active { background:#173b77; color:#fff; }

@keyframes fade-up { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes pulse { 0%, 100% { opacity: .3; transform: scale(.85); } 50% { opacity: 1; transform: scale(1); } }
