<view class="page"><view class="notice">周计划是本周训练方向，不要求每节课完全相同。</view><view class="card"><view class="field"><text class="field-label">班级</text><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="pickClass"><view class="picker">{{classes[classIndex].name}}</view></picker></view><view class="field"><text class="field-label">参考训练大纲</text><picker range="{{curriculums}}" range-key="name" value="{{curriculumIndex}}" bindchange="pickCurriculum"><view class="picker">{{curriculums[curriculumIndex].name}}</view></picker></view><view class="date-row"><view class="field"><text class="field-label">训练周开始</text><picker mode="date" value="{{form.weekStart}}" data-key="weekStart" bindchange="date"><view class="picker">{{form.weekStart}}</view></picker></view><view class="field"><text class="field-label">训练周结束</text><picker mode="date" value="{{form.weekEnd}}" data-key="weekEnd" bindchange="date"><view class="picker">{{form.weekEnd}}</view></picker></view></view><view class="field"><text class="field-label">从大纲选择主题</text><picker range="{{topics}}" range-key="name" value="{{topicIndex}}" bindchange="pickTopic"><view class="picker">{{topics[topicIndex].name}}</view></picker></view><view class="field"><text class="field-label">本周主题（允许自定义）</text><input class="input" value="{{form.mainTheme}}" data-key="mainTheme" bindinput="field"/></view><view class="field"><text class="field-label">本周训练重点</text><textarea class="textarea" value="{{form.trainingFocusText}}" placeholder="用顿号或换行分隔，例如：变向、加速、突破后的射门" data-key="trainingFocusText" bindinput="field"/></view><view class="field"><text class="field-label">周六会议调整备注（内部）</text><textarea class="textarea" value="{{form.meetingNote}}" data-key="meetingNote" bindinput="field"/></view></view><view class="actions"><button class="btn-secondary" loading="{{saving}}" bindtap="save">保存草稿</button><button class="btn-primary" bindtap="confirm">确认周计划</button></view></view>

