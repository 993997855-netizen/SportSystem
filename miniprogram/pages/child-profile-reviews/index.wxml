<view class="page"><view class="loading-state" wx:if="{{loading}}">加载中...</view><block wx:else><view class="card" wx:for="{{rows}}" wx:key="id"><view class="between"><view class="row"><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view><view class="headline">{{item.name}}</view><view class="muted small">{{item.gender}} · {{item.birthDate}} · {{item.school}} {{item.grade}}</view></view></view><view class="tag warning">待审核</view></view><view class="private"><view>身份证：{{item.idCardNumber}}</view><view class="muted small">仅当前管理员审核接口返回</view></view><view class="muted small">家长：{{item.parentName}} {{item.parentMobile}} · 提交于 {{item.createdAt}}</view><view class="warning-text" wx:if="{{item.duplicateStudentId}}">发现可能已有档案：{{item.duplicateStudentId}}，确认后将绑定已有学员。</view><view class="actions"><button class="btn-secondary" data-id="{{item.id}}" data-decision="REJECT" bindtap="review">退回修改</button><button class="btn-primary" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review">确认创建/绑定</button></view></view><view class="empty card" wx:if="{{rows.length === 0}}">暂无待审核资料</view></block></view>
