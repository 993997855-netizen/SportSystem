<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
<view class="page page-enter detail" wx:elif="{{session}}">
  <view class="hero brand-hero"><view class="tag gold">{{session.enrollmentMode === 'fixed' ? '梯队固定课' : '开放报名'}}</view><view class="title">{{session.title}}</view><view class="focus">{{session.focus}}</view></view>
  <view class="card info"><view><text>日期</text><text>{{session.date}} {{session.weekday}}</text></view><view><text>时间</text><text>{{session.time}}</text></view><view><text>场地</text><text>{{session.venue}}</text></view><view><text>教练</text><text>{{session.coachName}}</text></view></view>
  <view class="card"><view class="between"><view><view class="muted small">课程名额</view><view class="capacity">{{session.enrolledCount}} / {{session.capacity}}</view></view><view class="tag {{session.remaining ? '' : 'gold'}}">{{session.remaining ? '剩余'+session.remaining+'位' : '名额已满'}}</view></view><view class="progress"><view style="width:{{progress}}%"></view></view><view class="muted small rule">报名不立即扣课；教练确认到课或缺勤后生成课时流水。</view></view>
  <block wx:if="{{role !== 'parent'}}">
    <view class="section-title">课程管理</view><view class="actions"><button class="btn-primary" bindtap="attendance">手机点名</button><button class="btn-secondary" bindtap="feedback">发布反馈</button><button class="btn-secondary" bindtap="leaves">请假审核</button><button wx:if="{{role === 'admin'}}" class="btn-secondary" bindtap="edit">编辑课程</button></view>
    <view class="section-title">报名名单</view><view class="card roster" wx:for="{{session.enrollments}}" wx:key="id"><view class="avatar">{{item.student.initial}}</view><view class="grow"><view class="student-name">{{item.student.name}}</view><view class="muted small">剩余 {{item.student.remainingLessons}} 节</view></view><view class="link" data-student="{{item.studentId}}" bindtap="feedback">写反馈</view></view><view class="empty card" wx:if="{{!session.enrollments || session.enrollments.length === 0}}">暂无报名学员</view>
    <view class="section-title" wx:if="{{session.waiting.length}}">历史候补记录（只读）</view><view class="card wait" wx:for="{{session.waiting}}" wx:key="id"><text>原第{{item.position}}位 · {{item.student.name}}</text><text class="muted small">{{item.createdAt}}</text></view>
  </block>
  <view class="bottom-space" wx:if="{{role === 'parent'}}"></view><view class="fixed" wx:if="{{role === 'parent'}}"><button class="{{session.myStatus === 'booked' ? 'btn-secondary' : 'btn-primary'}}" disabled="{{session.classType === 'ELITE' || (session.isFull && session.myStatus === 'none')}}" loading="{{acting}}" bindtap="primary">{{session.myStatus === 'booked' ? '提交请假' : session.myStatus === 'waiting_history' ? '历史候补记录' : session.myStatus === 'leave_pending' ? '请假审核中' : session.classType === 'ELITE' ? '精英队由俱乐部选拔' : session.isFull ? '本节课程已满' : '立即报名'}}</button></view>
</view>
