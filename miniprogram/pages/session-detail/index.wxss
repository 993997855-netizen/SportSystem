.detail{padding-bottom:160rpx}.hero{border-radius:28rpx;padding:34rpx}.title{font-size:44rpx;font-weight:800;margin:22rpx 0 10rpx}.focus{color:#dce6f6}.info{margin-top:20rpx}.info>view{display:flex;justify-content:space-between;padding:15rpx 0;border-bottom:1rpx solid #edf0f5}.info>view:last-child{border:0}.info text:first-child{color:#8a94a5}.capacity{font-size:42rpx;font-weight:800;color:#173b77;margin-top:6rpx}.progress{height:12rpx;background:#e7ebf2;border-radius:99rpx;margin-top:22rpx;overflow:hidden}.progress view{height:100%;background:#d1a72f}.rule{margin-top:18rpx;line-height:1.6}.actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.roster{display:flex;align-items:center}.avatar{width:68rpx;height:68rpx;border-radius:50%;background:#eaf0f9;color:#173b77;display:flex;align-items:center;justify-content:center;font-weight:800;margin-right:18rpx;flex:0 0 auto}.avatar.photo{object-fit:cover}.student-name{font-weight:700}.link{color:#2d5ea8}.wait{display:flex;justify-content:space-between}.fixed{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 28rpx rgba(20,45,85,.09)}.bottom-space{height:100rpx}
.attendance-stats{display:grid;grid-template-columns:repeat(5,1fr);text-align:center}.attendance-stats text{display:block}.attendance-stats text:first-child{font-size:32rpx;font-weight:800;color:#173b77}.attendance-stats text:last-child{font-size:20rpx;color:#8a94a5;margin-top:7rpx}
.training-title{font-size:32rpx;font-weight:800;color:#173b77;margin:12rpx 0}.training-tag{display:inline-block;background:#e9f5ee;color:#12643b;padding:7rpx 13rpx;border-radius:99rpx;margin-right:8rpx;font-size:21rpx}.parent-summary{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf0f5;line-height:1.65}
.detail-coach{display:flex;align-items:center;gap:10rpx}.detail-coach image,.coach-avatar-fallback{width:42rpx;height:42rpx;border-radius:50%}.coach-avatar-fallback{display:flex;align-items:center;justify-content:center;background:#eaf5ee;color:#126b3d;font-size:20rpx;font-weight:700}
