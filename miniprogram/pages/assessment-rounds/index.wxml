<view class="page page-enter"><view class="hint">阶段测评保存独立历史快照，只和球员自己的上一期比较；评分不会自动触发精英队晋升。</view><view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="card row pressable" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="grow"><view class="name">{{item.name}}</view><view class="muted small">{{item.assessmentDate}} · {{item.coachName}}</view><view class="progress"><view style="width:{{item.expected ? item.completed / item.expected * 100 : 0}}%"></view></view></view><view><view class="tag {{item.status === 'COMPLETED' ? '' : 'gold'}}">{{item.status === 'COMPLETED' ? '已发布' : '进行中'}}</view><view class="count">{{item.progressText}}</view></view></view><view class="empty card" wx:if="{{!loading && rows.length === 0}}">暂无阶段测评</view><floating-add-button wx:if="{{role === 'admin'}}" bind:add="add" /></view>
