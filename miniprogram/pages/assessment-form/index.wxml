<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:else><view class="hero brand-hero"><view class="title">{{student.name}}</view><view class="sub">{{detail.name}} · 第{{index + 1}}/{{detail.students.length}}名</view></view><view class="notice">1需要重点培养 · 2正在建立 · 3基本掌握 · 4表现良好 · 5表现突出</view><view class="card metric" wx:for="{{rows}}" wx:key="metricKey"><view><view class="name">{{item.metricName}}</view><view class="muted small">{{item.categoryName}}</view></view><picker range="{{scoreOptions}}" value="{{item.scoreIndex}}" data-index="{{index}}" bindchange="score"><view class="score">{{item.score}} / 5 ›</view></picker></view><view class="card"><view class="field"><text class="field-label">本阶段亮点</text><input class="input" placeholder="用顿号分隔" value="{{strengthsText}}" data-key="strengthsText" bindinput="field" /></view><view class="field"><text class="field-label">下一阶段重点</text><input class="input" placeholder="用顿号分隔" value="{{developmentText}}" data-key="developmentText" bindinput="field" /></view><view class="field"><text class="field-label">教练评语</text><textarea class="textarea" value="{{coachComment}}" data-key="coachComment" bindinput="field" /></view><view class="field"><text class="field-label">教练寄语</text><textarea class="textarea" value="{{coachMessage}}" data-key="coachMessage" bindinput="field" /></view><view class="between"><view><view>发布后家长可见</view><view class="muted small">内部选拔意见建议保持关闭</view></view><switch checked="{{visibility === 'PARENT_VISIBLE'}}" bindchange="visible" color="#12643b"/></view></view><view class="actions"><button class="btn-secondary" loading="{{saving}}" bindtap="draft">保存草稿</button><button class="btn-primary" loading="{{saving}}" bindtap="complete">完成并下一位</button></view></view>
