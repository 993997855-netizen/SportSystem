<view class="page page-enter"><view class="notice">进球和助攻仅作客观记录，不用于自动排名或精英队晋升。</view><view class="card"><view class="field"><text class="field-label">比赛日期 *</text><picker mode="date" value="{{matchDate}}" bindchange="date"><view class="picker">{{matchDate}}</view></picker></view><view class="field"><text class="field-label">本方队伍 *</text><input class="input" value="{{teamName}}" data-key="teamName" bindinput="field" /></view><view class="field"><text class="field-label">对手 *</text><input class="input" value="{{opponent}}" data-key="opponent" bindinput="field" /></view><view class="field"><text class="field-label">位置</text><input class="input" value="{{position}}" data-key="position" bindinput="field" /></view><view class="grid"><view class="field"><text class="field-label">出场分钟</text><input class="input" type="number" value="{{minutesPlayed}}" data-key="minutesPlayed" bindinput="field" /></view><view class="field"><text class="field-label">进球</text><input class="input" type="number" value="{{goals}}" data-key="goals" bindinput="field" /></view><view class="field"><text class="field-label">助攻</text><input class="input" type="number" value="{{assists}}" data-key="assists" bindinput="field" /></view></view><view class="field"><text class="field-label">教练表现评分（1-5）</text><slider min="1" max="5" step="1" value="{{coachRating}}" show-value data-key="coachRating" bindchange="field" activeColor="#12643b"/></view><view class="field"><text class="field-label">教练评价</text><textarea class="textarea" value="{{coachComment}}" data-key="coachComment" bindinput="field" /></view><view class="between"><view><view>家长可见</view><view class="muted small">关闭时仅俱乐部内部可见</view></view><switch checked="{{visibility === 'PARENT_VISIBLE'}}" bindchange="visible" color="#12643b"/></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存比赛记录</button></view>
