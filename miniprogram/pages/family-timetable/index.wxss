.timetable-hero{min-height:220rpx;padding:34rpx 30rpx;border-radius:26rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:0 14rpx 34rpx rgba(16,47,99,.16);overflow:hidden}
.eyebrow{font-size:20rpx;line-height:1.3;letter-spacing:4rpx;color:#e8ca68;opacity:.92}
.title{font-size:42rpx;line-height:1.2;font-weight:850;margin:12rpx 0}
.sub{font-size:24rpx;line-height:1.5;color:#e2eaf6}
.child-picker{min-height:88rpx;background:#fff;border:1rpx solid #e8edf4;border-radius:20rpx;padding:20rpx 24rpx;margin-top:18rpx;display:flex;align-items:center;color:#173b77;box-shadow:0 5rpx 18rpx rgba(23,59,119,.045)}
.picker-label{font-size:23rpx;color:#7a8591;margin-right:16rpx}
.picker-value{flex:1;min-width:0;font-size:28rpx;font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.picker-arrow{font-size:38rpx;line-height:1;color:#8190a5}
.week-nav{min-height:94rpx;display:flex;align-items:center;justify-content:space-between;background:#fff;border:1rpx solid #e8edf4;border-radius:20rpx;padding:14rpx 20rpx;margin:16rpx 0;color:#173b77;box-shadow:0 5rpx 18rpx rgba(23,59,119,.04)}
.week-action{min-height:60rpx;display:flex;align-items:center;padding:0 8rpx}
.week-nav .current{min-width:112rpx;min-height:60rpx;background:#173b77;color:#fff;border-radius:999rpx;padding:10rpx 24rpx;display:flex;align-items:center;justify-content:center;text-align:center}
.summary{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:20rpx}
.summary-item{min-height:108rpx;padding:18rpx;background:#fff;border:1rpx solid #e8edf4;border-radius:18rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.summary-value{font-size:34rpx;line-height:1.1;font-weight:850;color:#173b77}
.summary-label{margin-top:8rpx;color:#718090;font-size:22rpx}
.day-title{font-size:30rpx;font-weight:800;margin:24rpx 2rpx 13rpx}
.timeline{border-left:4rpx solid #dbe3ee;padding-left:20rpx}
.schedule{padding:24rpx}
.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.tag,.child{display:inline-block;background:#eaf0f9;color:#173b77;padding:6rpx 14rpx;border-radius:999rpx;font-size:20rpx}
.child{background:#edf1f8;color:#173b77;margin-left:8rpx}
.status{font-size:22rpx;color:#7a817d;white-space:nowrap}
.time{font-size:29rpx;color:#173b77;font-weight:800;margin-top:14rpx}
.name{font-size:30rpx;font-weight:800;margin-top:7rpx}
.meta,.theme,.match-note{font-size:23rpx;color:#66727e;margin-top:8rpx;line-height:1.55}
.leave{background:#eef6ff;color:#175b95;padding:10rpx 14rpx;border-radius:12rpx;margin-top:12rpx}
.match-note{color:#a86100}
.timetable-empty{line-height:1.75;padding-top:42rpx;padding-bottom:42rpx}
.empty-mark{width:70rpx;height:70rpx;margin:0 auto 16rpx;border-radius:50%;background:#eaf0f9;color:#173b77;display:flex;align-items:center;justify-content:center;font-weight:800}
.joined{color:#5c6875;font-size:25rpx}
.empty-main{margin-top:5rpx;color:#314050;font-size:29rpx;font-weight:750}
.timetable-empty .muted{max-width:520rpx;margin:10rpx auto 0}
