.child-picker{background:#fff;border-radius:20rpx;padding:24rpx;margin-top:20rpx;color:#173b77;font-weight:700}.week-nav{display:flex;justify-content:space-between;background:#fff;border-radius:20rpx;padding:22rpx;margin:16rpx 0;color:#173b77}.week-nav .current{background:#173b77;color:#fff;border-radius:999rpx;padding:10rpx 28rpx}.summary{display:flex;justify-content:space-between;color:#66716b;padding:8rpx 6rpx 20rpx}.day-title{font-size:30rpx;font-weight:800;margin:26rpx 0 14rpx}.timeline{border-left:4rpx solid #d9e9df;padding-left:22rpx}.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:16rpx}.between{display:flex;justify-content:space-between}.tag,.child{display:inline-block;background:#e4f3ea;color:#08783f;padding:6rpx 14rpx;border-radius:999rpx;font-size:20rpx}.child{background:#edf1f8;color:#173b77;margin-left:8rpx}.status{font-size:22rpx;color:#7a817d}.time{font-size:29rpx;color:#08783f;font-weight:800;margin-top:14rpx}.name{font-size:31rpx;font-weight:800;margin-top:8rpx}.meta,.theme,.match-note{font-size:23rpx;color:#66716b;margin-top:9rpx}.leave{background:#eef6ff;color:#175b95;padding:12rpx 16rpx;border-radius:12rpx;margin-top:14rpx}.match-note{color:#a86100}
