<view class="crm-hero"><view class="crm-title">招生中心</view><view class="crm-sub">咨询 → 跟进 → 体验课 → 成交 → 正式学员</view></view>
<view class="loading-state" wx:if="{{loading}}">正在加载招生数据...</view>
<view class="page page-enter" wx:else>
  <view class="section-title">今日数据</view><view class="metric-grid"><view class="metric"><text class="metric-value">{{dashboard.today.newLeads || 0}}</text><text class="metric-label">新增线索</text></view><view class="metric"><text class="metric-value">{{dashboard.today.due || 0}}</text><text class="metric-label">待跟进</text></view><view class="metric"><text class="metric-value">{{dashboard.today.scheduled || 0}}</text><text class="metric-label">预约体验课</text></view><view class="metric"><text class="metric-value">{{dashboard.today.trials || 0}}</text><text class="metric-label">完成体验课</text></view><view class="metric"><text class="metric-value">{{dashboard.today.won || 0}}</text><text class="metric-label">今日成交</text></view></view>
  <view class="section-title">本月经营</view><view class="card between"><view><view class="muted small">体验课 / 报名</view><view class="month-value">{{dashboard.month.trials || 0}} / {{dashboard.month.won || 0}}</view></view><view><view class="muted small">转化率</view><view class="month-value gold">{{dashboard.month.conversionRate || 0}}%</view></view><view><view class="muted small">成交金额</view><view class="month-value">¥{{dashboard.month.amount || 0}}</view></view></view>
  <view class="section-title">业务入口</view><view class="crm-nav-grid"><view class="crm-nav" data-url="/pages/leads/index?view=all" bindtap="go"><view class="crm-nav-title">全部线索</view><view class="crm-nav-sub">统一查询和筛选</view></view><view class="crm-nav" data-url="/pages/leads/index?view=my" bindtap="go"><view class="crm-nav-title">我的线索</view><view class="crm-nav-sub">负责人工作台</view></view><view class="crm-nav" data-url="/pages/leads/index?view=due" bindtap="go"><view class="crm-nav-title">待跟进 {{dashboard.overdue || 0}}</view><view class="crm-nav-sub">逾期和今日任务</view></view><view class="crm-nav" data-url="/pages/trials/index" bindtap="go"><view class="crm-nav-title">体验课管理</view><view class="crm-nav-sub">预约、点名与反馈</view></view><view class="crm-nav" data-url="/pages/leads/index?view=public" bindtap="go"><view class="crm-nav-title">公海池 {{dashboard.publicCount || 0}}</view><view class="crm-nav-sub">领取与重新分配</view></view><view class="crm-nav" wx:if="{{role === 'admin'}}" data-url="/pages/crm-stats/index" bindtap="go"><view class="crm-nav-title">招生统计</view><view class="crm-nav-sub">渠道与负责人分析</view></view></view>
  <view class="section-title">线索漏斗</view><view class="card"><view class="funnel" wx:for="{{dashboard.funnel}}" wx:key="status"><view class="between"><text>{{item.label}}</text><text class="funnel-count">{{item.count}}</text></view><view class="bar"><view class="bar-fill" style="width:{{item.width}}%"></view></view></view></view>
  <view class="section-title">最近更新</view><view class="card pressable" wx:for="{{dashboard.recent}}" wx:key="id" data-id="{{item.id}}" bindtap="lead"><view class="between"><view><view class="lead-name">{{item.childName}}</view><view class="muted small lead-meta">{{item.parentName}} · {{item.mobile}} · {{item.ownerCoachName || '未分配'}}</view></view><view class="badge {{item.intentionClass}}">{{item.intentionLevel}}级</view></view></view>
  <floating-add-button bind:add="add" />
</view>


