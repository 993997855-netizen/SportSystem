<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="page page-enter" wx:else>
  <view class="card">
    <view class="field"><text class="field-label">所属班级</text><picker mode="selector" range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="classChange"><view class="picker">{{classes[classIndex].name || '请选择班级'}}</view></picker></view>
    <view class="field"><text class="field-label">课程名称</text><input class="input" value="{{session.title}}" data-key="title" bindinput="field"/></view>
    <view class="field"><text class="field-label">训练日期</text><picker mode="date" value="{{session.date}}" bindchange="dateChange"><view class="picker">{{session.date || '请选择日期'}}</view></picker></view>
    <view class="field"><text class="field-label">训练时间</text><input class="input" placeholder="例如 19:00-20:30" value="{{session.time}}" data-key="time" bindinput="field"/></view>
    <view class="field"><text class="field-label">训练场地</text><input class="input" value="{{session.venue}}" data-key="venue" bindinput="field"/></view>
    <view class="field"><text class="field-label">计划执教教练</text><view class="coach-preview" wx:for="{{plannedPreview}}" wx:key="name"><text>{{item.name}}</text><text>{{item.roleLabel}}</text></view><view class="field-help">发布时保存课程快照；之后修改班级教练不会改写本节计划。</view></view>
    <view class="field"><text class="field-label">本节安全人数上限（含体验）</text><input class="input" type="number" value="{{session.capacity}}" data-key="capacity" bindinput="field"/></view>
    <view class="field"><text class="field-label">报名方式</text><picker mode="selector" range="{{modes}}" value="{{session.enrollmentMode === 'open' ? 0 : 1}}" bindchange="modeChange"><view class="picker">{{session.enrollmentMode === 'open' ? '开放报名' : '梯队固定'}}</view></picker></view>
    <view class="field"><text class="field-label">训练主题</text><input class="input" placeholder="例如：1V1进攻" value="{{session.trainingTheme}}" data-key="trainingTheme" bindinput="field"/></view>
    <view class="field"><text class="field-label">训练重点</text><textarea class="textarea" placeholder="例如：变向 / 加速 / 突破后的射门" value="{{session.trainingFocus || session.focus}}" data-key="trainingFocus" bindinput="field"/></view>
    <view class="field"><text class="field-label">内部训练备注</text><textarea class="textarea" placeholder="仅管理员和教练可见" value="{{session.trainingNote}}" data-key="trainingNote" bindinput="field"/></view>
  </view>
  <button class="btn-primary" loading="{{saving}}" bindtap="save">{{id ? '保存修改' : '发布课程'}}</button>
</view>
