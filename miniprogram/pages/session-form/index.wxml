<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="page page-enter" wx:else>
  <view class="card"><view class="field"><text class="field-label">所属班级</text><picker mode="selector" range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="classChange"><view class="picker">{{classes[classIndex].name || '请选择班级'}}</view></picker></view><view class="field"><text class="field-label">课程名称</text><input class="input" value="{{session.title}}" data-key="title" bindinput="field" /></view><view class="field"><text class="field-label">训练日期</text><picker mode="date" value="{{session.date}}" bindchange="dateChange"><view class="picker">{{session.date || '请选择日期'}}</view></picker></view><view class="field"><text class="field-label">训练时间</text><input class="input" placeholder="例如 19:00-20:30" value="{{session.time}}" data-key="time" bindinput="field" /></view><view class="field"><text class="field-label">训练场地</text><input class="input" value="{{session.venue}}" data-key="venue" bindinput="field" /></view><view class="field"><text class="field-label">主教练</text><input class="input" value="{{session.coachName}}" data-key="coachName" bindinput="field" /></view><view class="field"><text class="field-label">人数上限</text><input class="input" type="number" value="{{session.capacity}}" data-key="capacity" bindinput="field" /></view><view class="field"><text class="field-label">报名方式</text><picker mode="selector" range="{{modes}}" value="{{session.enrollmentMode === 'open' ? 0 : 1}}" bindchange="modeChange"><view class="picker">{{session.enrollmentMode === 'open' ? '开放报名' : '梯队固定'}}</view></picker></view><view class="field"><text class="field-label">训练重点</text><textarea class="textarea" placeholder="本节课训练主题和目标" value="{{session.focus}}" data-key="focus" bindinput="field" /></view></view>
  <button class="btn-primary" loading="{{saving}}" bindtap="save">{{id ? '保存修改' : '发布课程'}}</button>
</view>
