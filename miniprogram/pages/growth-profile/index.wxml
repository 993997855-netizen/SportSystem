<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter" wx:elif="{{profile}}">
  <view class="hero brand-hero"><view class="eyebrow">NANLIAN PLAYER DEVELOPMENT</view><view class="title">{{profile.student.name}}</view><view class="sub">{{profile.student.classNamesText || '暂未分班'}}</view><view class="hero-grid"><view><text>{{profile.student.trainingDuration}}</text><text>训练年限</text></view><view><text>{{profile.student.remainingLessons}}节</text><text>当前课时</text></view><view><text>{{profile.student.latestTrainingDate}}</text><text>最近训练</text></view><view><text>{{profile.attendance.present}} / {{profile.attendance.total}}</text><text>本月到课</text></view></view></view>
  <view class="card ability" wx:if="{{profile.latestAssessment}}"><view class="between"><view><view class="muted small">当前综合能力</view><view class="overall">{{profile.latestAssessment.overallScore}} <text>/ 5</text></view></view><view class="tag">{{profile.latestAssessment.assessmentDate}}</view></view><canvas canvas-id="radarCanvas" class="chart radar"></canvas><view class="compare"><view wx:for="{{profile.comparisons}}" wx:key="key"><text>{{item.name}}</text><text class="score">{{item.score}}</text><text class="delta {{item.direction}}">{{item.deltaText}}</text></view></view></view>
  <view class="empty card" wx:else>尚无已发布阶段测评</view>
  <view class="between section-title"><text>成长趋势</text><picker range="{{categoryOptions}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><text class="link">{{categoryOptions[categoryIndex].name}} ›</text></picker></view><view class="card"><view class="limit"><text class="{{trendLimit === 3 ? 'active' : ''}}" data-limit="3" bindtap="limit">最近3次</text><text class="{{trendLimit === 6 ? 'active' : ''}}" data-limit="6" bindtap="limit">最近6次</text></view><canvas canvas-id="trendCanvas" class="chart trend"></canvas></view>
  <view class="section-title" wx:if="{{profile.latestAssessment}}">最近阶段测评</view><view class="card" wx:if="{{profile.latestAssessment}}"><view class="headline">{{profile.latestAssessment.assessmentName}}</view><view class="copy"><text>本阶段亮点</text><view>{{profile.latestAssessment.strengthsText || '暂无'}}</view></view><view class="copy"><text>下一阶段重点</text><view>{{profile.latestAssessment.developmentAreasText || '暂无'}}</view></view><view class="copy"><text>教练寄语</text><view>{{profile.latestAssessment.coachMessage || profile.latestAssessment.coachComment}}</view></view></view>
  <view class="section-title">最近训练评价</view><view class="card record" wx:for="{{profile.feedback}}" wx:key="id"><view class="between"><view class="headline">{{item.coachName}}</view><view class="tag">状态 {{item.trainingStatus || item.rating}}/5</view></view><view class="tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view><view class="copy">{{item.content || item.highlights}}</view><view class="muted small">{{item.createdAt}}</view></view><view class="empty card" wx:if="{{profile.feedback.length === 0}}">暂无公开训练评价</view>
  <view class="between section-title"><text>比赛记录</text><text class="link" wx:if="{{role !== 'parent'}}" bindtap="match">添加比赛 ›</text></view><view class="card record" wx:for="{{profile.matches}}" wx:key="id"><view class="between"><view class="headline">{{item.teamName}} vs {{item.opponent}}</view><view class="tag">{{item.coachRating}}/5</view></view><view class="muted small">{{item.matchDate}} · {{item.position}} · {{item.minutesPlayed}}分钟</view><view class="copy">{{item.coachComment}}</view></view><view class="empty card" wx:if="{{profile.matches.length === 0}}">暂无公开比赛记录</view>
  <view class="section-title">成长时间轴</view><view class="timeline"><view class="event" wx:for="{{profile.events}}" wx:key="id"><view class="dot"></view><view class="card"><view class="muted small">{{item.eventDate}}</view><view class="headline">{{item.title}}</view><view class="copy">{{item.description}}</view></view></view></view>
</view>
