.hero{border-radius:28rpx;padding:32rpx}.eyebrow{font-size:18rpx;letter-spacing:2rpx;color:#e2bd52}.title{font-size:45rpx;font-weight:850;margin:10rpx 0}.sub{color:#dce6f6}.hero-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:28rpx;border-top:1rpx solid rgba(255,255,255,.18);padding-top:20rpx}.hero-grid text{display:block;text-align:center}.hero-grid text:first-child{font-weight:750;font-size:24rpx}.hero-grid text:last-child{font-size:18rpx;color:#cdd9ec;margin-top:6rpx}.overall{font-size:56rpx;color:#12643b;font-weight:850}.overall text{font-size:24rpx}.chart{width:640rpx}.radar{height:440rpx}.trend{height:360rpx}.compare{display:grid;grid-template-columns:repeat(5,1fr);gap:8rpx}.compare view{text-align:center;background:#f5f7fa;border-radius:12rpx;padding:14rpx 4rpx}.compare text{display:block;font-size:20rpx}.compare .score{font-size:30rpx;font-weight:800;margin:6rpx 0}.delta.up{color:#12643b}.delta.down{color:#bd5b42}.limit{display:flex;gap:16rpx}.limit text{padding:10rpx 18rpx;border-radius:99rpx;background:#eef1f5;color:#728095;font-size:22rpx}.limit .active{background:#12643b;color:#fff}.headline{font-weight:750;font-size:29rpx}.copy{margin-top:16rpx;line-height:1.7;color:#526173}.copy>text{display:block;color:#173b77;font-weight:700;margin-bottom:4rpx}.tags{margin-top:14rpx}.tags text{display:inline-block;background:#eaf4ee;color:#12643b;padding:8rpx 13rpx;border-radius:99rpx;font-size:21rpx;margin:0 8rpx 8rpx 0}.record{margin-bottom:16rpx}.timeline{border-left:3rpx solid #dbe4dd;margin-left:16rpx;padding-left:28rpx}.event{position:relative}.event .dot{position:absolute;width:18rpx;height:18rpx;background:#12643b;border:6rpx solid #dff0e6;border-radius:50%;left:-43rpx;top:28rpx}.event .card{margin-bottom:16rpx}
