<view class="page page-enter"><picker range="{{ranges}}" bindchange="range"><view class="card picker">统计范围：{{rangeLabel}}</view></picker><view class="card row"><picker class="grow" mode="date" value="{{start}}" bindchange="start"><view class="picker">{{start}}</view></picker><text class="range">至</text><picker class="grow" mode="date" value="{{end}}" bindchange="end"><view class="picker">{{end}}</view></picker></view><view class="metric-grid"><view class="metric"><text class="metric-value">{{stats.summary.leads || 0}}</text><text class="metric-label">新增线索</text></view><view class="metric"><text class="metric-value">{{stats.summary.trials || 0}}</text><text class="metric-label">完成体验课</text></view><view class="metric"><text class="metric-value">{{stats.summary.won || 0}}</text><text class="metric-label">成交人数</text></view><view class="metric"><text class="metric-value">{{stats.summary.rate || 0}}%</text><text class="metric-label">体验转化率</text></view><view class="metric"><text class="metric-value">¥{{stats.summary.amount || 0}}</text><text class="metric-label">成交金额</text></view></view><view class="section-title">渠道分析</view><view class="card channel" wx:for="{{stats.channels}}" wx:key="source"><view class="between"><view class="lead-name">{{item.source}}</view><view class="badge">转化 {{item.rate}}%</view></view><view class="muted small lead-meta">线索 {{item.leads}} · 体验 {{item.trials}} · 报名 {{item.won}}</view></view><view class="section-title">负责人数据</view><view class="card channel" wx:for="{{stats.coaches}}" wx:key="id"><view class="between"><view class="lead-name">{{item.name}}</view><view class="badge">成交率 {{item.rate}}%</view></view><view class="muted small lead-meta">负责 {{item.leads}} · 已联系 {{item.contacted}} · 体验 {{item.trials}} · 成交 {{item.won}}</view></view></view>


