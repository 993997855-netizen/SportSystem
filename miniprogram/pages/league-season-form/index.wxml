<view class="page"><view class="notice">单双周年龄组属于可调整排程建议，不会硬锁定比赛日。</view><view class="card"><view class="field"><text class="field-label">赛季名称</text><input class="input" value="{{name}}" data-key="name" bindinput="field" placeholder="如：2027春季成长联赛"/></view><view class="field"><text class="field-label">开始日期</text><picker mode="date" value="{{startDate}}" data-key="startDate" bindchange="date"><view class="picker">{{startDate}}</view></picker></view><view class="field"><text class="field-label">结束日期</text><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="date"><view class="picker">{{endDate}}</view></picker></view><view class="field"><text class="field-label">单双周计算</text><picker range="{{modes}}" range-key="name" value="{{modeIndex}}" bindchange="mode"><view class="picker">{{modes[modeIndex].name}}</view></picker></view><view class="field"><text class="field-label">单周年份（逗号分隔）</text><input class="input" value="{{oddYears}}" data-key="oddYears" bindinput="field"/></view><view class="field"><text class="field-label">双周年份（逗号分隔）</text><input class="input" value="{{evenYears}}" data-key="evenYears" bindinput="field"/></view><view class="between"><view>家长端显示积分榜</view><switch checked="{{standingsEnabled}}" bindchange="standings" color="#173b77"/></view><view class="field" wx:if="{{standingsEnabled}}"><text class="field-label">积分规则（胜 / 平 / 负）</text><view class="points"><input class="input" type="number" value="{{winPoints}}" data-key="winPoints" bindinput="field"/><input class="input" type="number" value="{{drawPoints}}" data-key="drawPoints" bindinput="field"/><input class="input" type="number" value="{{lossPoints}}" data-key="lossPoints" bindinput="field"/></view></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">创建并生成周日轮次</button></view>
