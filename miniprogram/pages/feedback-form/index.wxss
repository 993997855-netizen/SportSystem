.intro{border-radius:26rpx;padding:30rpx;margin-bottom:20rpx;line-height:1.7}.intro .title{font-size:38rpx;font-weight:800}.form{margin-bottom:22rpx}
.tags{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx}
.tags label{display:flex;align-items:center;gap:8rpx;padding:12rpx 18rpx;border-radius:999rpx;background:#f3f7f4;color:#315e43;font-size:25rpx}
.selected-student{display:flex;align-items:center;gap:20rpx}.student-photo{width:92rpx;height:92rpx;border-radius:50%;object-fit:cover;flex:0 0 auto}.student-photo.fallback{display:flex;align-items:center;justify-content:center;background:#e9f5ee;color:#12643b;font-weight:800}.student-name{font-size:31rpx;font-weight:800}
