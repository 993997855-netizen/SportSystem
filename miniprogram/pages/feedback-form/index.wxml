<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:else><view class="intro brand-hero"><view class="title">日常训练评价</view><view>快速记录本堂表现，不代替正式阶段测评。</view></view><view class="card selected-student"><image wx:if="{{students[studentIndex].avatarUrl}}" class="student-photo" src="{{students[studentIndex].avatarUrl}}" mode="aspectFill"/><view wx:else class="student-photo fallback">{{students[studentIndex].initial}}</view><view><view class="student-name">{{students[studentIndex].name}}</view><view class="muted small">当前评价学员 · 通过照片确认身份</view></view></view><view class="card form"><view class="field"><text class="field-label">训练课程</text><view class="picker">{{session.title}} · {{session.date}}</view></view><view class="field"><text class="field-label">正式成员</text><picker range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="studentChange"><view class="picker">{{students[studentIndex].name}}</view></picker></view><view class="field"><text class="field-label">训练状态 1-5</text><slider min="1" max="5" step="1" value="{{trainingStatus}}" show-value bindchange="status" activeColor="#12643b"/></view><view class="field"><text class="field-label">快捷标签</text><checkbox-group class="tags" bindchange="tags"><label wx:for="{{tagOptions}}" wx:key="name"><checkbox value="{{item.name}}" checked="{{item.checked}}" color="#12643b"/>{{item.name}}</label></checkbox-group></view><view class="field"><text class="field-label">表现亮点</text><input class="input" value="{{highlights}}" data-key="highlights" bindinput="field" placeholder="例如：1V1突破积极" /></view><view class="field"><text class="field-label">需要提高</text><input class="input" value="{{developmentAreas}}" data-key="developmentAreas" bindinput="field" placeholder="例如：接球前观察" /></view><view class="field"><text class="field-label">教练评语</text><textarea class="textarea" maxlength="500" value="{{coachComment}}" data-key="coachComment" bindinput="field" /></view><view class="between"><view><view>家长可见</view><view class="muted small">内部选拔意见请保持关闭</view></view><switch checked="{{visibility === 'PARENT_VISIBLE'}}" bindchange="visible" color="#12643b"/></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存训练评价</button></view>
