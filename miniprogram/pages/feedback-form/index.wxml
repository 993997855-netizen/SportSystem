<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="page page-enter" wx:else>
  <view class="intro brand-hero"><view class="title">课后及时记录</view><view>让家长看到具体进步，让下一次训练有依据。</view></view>
  <view class="card form"><view class="field"><text class="field-label">训练课程</text><picker mode="selector" range="{{sessions}}" range-key="title" value="{{sessionIndex}}" bindchange="sessionChange"><view class="picker">{{sessions[sessionIndex].title}} · {{sessions[sessionIndex].date}}</view></picker></view><view class="field"><text class="field-label">反馈学员</text><picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="studentChange"><view class="picker">{{students[studentIndex].name}}</view></picker></view><view class="field"><text class="field-label">本次表现</text><picker mode="selector" range="{{ratings}}" value="{{ratingIndex}}" bindchange="ratingChange"><view class="picker">{{ratings[ratingIndex]}} / 5</view></picker></view><view class="field"><text class="field-label">能力标签</text><input class="input" placeholder="例如：突破积极，传球进步" value="{{tagsText}}" bindinput="tags" /></view><view class="field"><text class="field-label">教练反馈</text><textarea class="textarea" maxlength="500" placeholder="写清本次表现、问题和下阶段建议" value="{{content}}" bindinput="content" /></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">发布给家长</button>
</view>
