<view class="page"><view class="notice">教案是可复用模板；课程关联时会保存当时版本快照。</view><view class="card plan" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="between"><view class="title">{{item.title}}</view><view class="tag">V{{item.version}}</view></view><view class="muted small">{{item.ageGroups[0]}} · {{item.duration}}分钟 · {{item.planType === 'OFFICIAL' ? '南联官方' : '教练个人'}}</view><view><text class="tag-chip" wx:for="{{item.tagNames}}" wx:key="*this">{{item}}</text></view><view class="muted small blocks">{{item.sections.length}}个训练环节 · {{item.favorite ? '已收藏' : '可收藏'}}</view></view></view>
