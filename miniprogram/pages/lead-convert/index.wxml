<view class="page page-enter" wx:if="{{lead}}"><view class="card"><view class="lead-name">{{lead.childName}}</view><view class="muted lead-meta">{{lead.gender}} · {{lead.birthday}} · {{lead.school}} · {{lead.grade}}</view><view class="divider"></view><view class="between"><text class="muted">家长</text><text>{{lead.parentName}}</text></view><view class="between info"><text class="muted">手机号</text><text>{{lead.mobile}}</text></view><view class="between info"><text class="muted">招生来源</text><text>{{lead.source}}</text></view><view class="between info"><text class="muted">备注</text><text>{{lead.remark || '无'}}</text></view></view><view class="card"><view class="field"><text class="field-label">正式班级 *</text><checkbox-group bindchange="classes"><label class="check" wx:for="{{classes}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#173B77"/>{{item.name}}</label></checkbox-group></view><view class="field"><text class="field-label">购买套餐 / 初始课时</text><picker range="{{packages}}" range-key="name" value="{{packageIndex}}" bindchange="pack"><view class="picker">{{packages[packageIndex].name}} · {{packages[packageIndex].lessons}}节 · ¥{{packages[packageIndex].amount}}</view></picker></view><view class="field"><text class="field-label">报名日期</text><picker mode="date" value="{{registrationDate}}" bindchange="registrationDate"><view class="picker">{{registrationDate}}</view></picker></view><view class="field"><text class="field-label">招生负责人</text><picker range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="coach"><view class="picker">{{coaches[coachIndex].name || lead.ownerCoachName}}</view></picker></view><view class="notice">转换将复用正式学员建档逻辑，同时生成期初课时流水；CRM历史不会删除。</view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">确认转为正式学员</button></view>
