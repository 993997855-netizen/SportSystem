<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:else><view class="card"><view class="field"><text class="field-label">测评名称 *</text><input class="input" placeholder="例如：2026秋季第一阶段测评" value="{{name}}" bindinput="name" /></view><view class="field"><text class="field-label">班级 *</text><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="classChange"><view class="picker">{{classes[classIndex].name || '请选择班级'}}</view></picker></view><view class="field"><text class="field-label">年龄段模板 *</text><picker range="{{templates}}" range-key="name" value="{{templateIndex}}" bindchange="templateChange"><view class="picker">{{templates[templateIndex].name || '请选择模板'}}</view></picker></view><view class="field"><text class="field-label">测评日期</text><picker mode="date" value="{{date}}" bindchange="date"><view class="picker">{{date}}</view></picker></view><view class="field"><text class="field-label">负责教练</text><input class="input" value="{{coachName}}" bindinput="coach" /></view></view><view class="notice">系统不会强制测评周期；未完成全班测评前不能发布给家长。</view><button class="btn-primary" loading="{{saving}}" bindtap="save">创建测评</button></view>

