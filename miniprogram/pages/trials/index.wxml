<view class="page page-enter"><view class="card trial" wx:for="{{rows}}" wx:key="id"><view class="between"><view class="lead-name">{{item.childName}}</view><view class="badge">{{item.statusLabel}}</view></view><view class="muted lead-meta">{{item.trialDate}} · {{item.className || '未指定班级'}}</view><view class="muted small lead-meta">{{item.coachName}} · {{item.venueName}}</view><view class="action-row"><text class="action-chip" data-id="{{item.leadId}}" bindtap="lead">查看线索</text><text class="action-chip" wx:if="{{item.status === 'SCHEDULED'}}" data-session="{{item.sessionId}}" bindtap="attendance">体验课点名</text><text class="action-chip" wx:if="{{item.attendanceStatus === 'present' || item.status === 'COMPLETED'}}" data-id="{{item.id}}" bindtap="feedback">体验课反馈</text><text class="action-chip danger" wx:if="{{item.status === 'SCHEDULED'}}" data-id="{{item.id}}" bindtap="cancel">取消</text></view></view><view class="empty card" wx:if="{{!loading && rows.length === 0}}">暂无体验课预约</view><view class="loading-state" wx:if="{{loading}}">加载中...</view></view>


