.notice{margin-bottom:18rpx;padding:22rpx 24rpx;border-radius:16rpx;background:#eef6f1;color:#35624a;font-size:24rpx;line-height:1.6}.request{margin-bottom:18rpx}.person{display:flex;align-items:center;gap:16rpx}.avatar{width:82rpx;height:82rpx;border-radius:50%;flex:none}.fallback{background:#e7f4ec;color:#12643b;text-align:center;line-height:82rpx;font-weight:800}.name{font-size:31rpx;font-weight:750}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:22rpx 0;padding:18rpx 0;border-top:1rpx solid #edf0f3;border-bottom:1rpx solid #edf0f3}.grid view{display:flex;flex-direction:column;gap:6rpx;min-width:0}.grid text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:20rpx}.actions button{margin:0;border-radius:99rpx;padding:0 24rpx}.reject{background:#fff0f0;color:#b53737}.approve{background:#173b77;color:#fff}
