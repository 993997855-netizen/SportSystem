<view class="page"><view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><block wx:else><view class="card match-head"><view>{{match.matchDate}} {{startTime}}</view><view class="teams"><view>{{match.homeTeam.name}}</view><text>VS</text><view>{{match.awayTeam.name}}</view></view><view class="muted">{{venue}}</view></view><view class="action-row" wx:if="{{role !== 'parent'}}"><view class="action-chip" data-team="{{match.homeTeamId}}" bindtap="squad">主队名单</view><view class="action-chip" data-team="{{match.awayTeamId}}" bindtap="squad">客队名单</view></view><view class="card" wx:if="{{role === 'admin'}}"><view class="score-row"><input class="input" type="number" value="{{homeScore}}" data-key="homeScore" bindinput="field"/><text>:</text><input class="input" type="number" value="{{awayScore}}" data-key="awayScore" bindinput="field"/></view><view class="field"><text class="field-label">时间</text><input class="input" value="{{startTime}}" data-key="startTime" bindinput="field"/></view><view class="field"><text class="field-label">场地</text><input class="input" value="{{venue}}" data-key="venue" bindinput="field"/></view><button class="btn-primary" loading="{{saving}}" bindtap="save">确认完赛并回流成长档案</button></view><view class="notice">比赛不扣训练课时。只有南联内部球员会生成成长档案比赛记录。</view></block></view>
