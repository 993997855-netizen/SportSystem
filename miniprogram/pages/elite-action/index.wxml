<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}</view><view class="page page-enter" wx:else><view class="hint">成长数据仅作为人工判断参考。教练提交推荐，管理员拥有最终决定权，系统不会按分数自动晋升。</view><view class="card growth-ref"><view class="between"><view class="field-label">成长参考</view><view class="tag" wx:if="{{growth.latestAssessment}}">综合 {{growth.latestAssessment.overallScore}}/5</view></view><view class="muted small" wx:if="{{growth.latestAssessment}}">最近测评：{{growth.latestAssessment.assessmentName}} · {{growth.latestAssessment.assessmentDate}}</view><view class="muted small" wx:else>暂无已完成阶段测评</view><view class="muted small">本月到课 {{growth.attendance.present}} / {{growth.attendance.total}} · 训练评价 {{growth.recentFeedback.length}} 条 · 比赛记录 {{growth.matches.length}} 条</view></view><view class="card"><view class="field"><text class="field-label">目标精英队 *</text><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="classChange"><view class="picker">{{classes[classIndex].name || '暂无可选精英队'}}</view></picker></view><view class="field"><text class="field-label">{{role === 'admin' ? '晋升依据' : '推荐理由'}} *</text><textarea class="textarea" value="{{reason}}" bindinput="field" placeholder="结合阶段测评、训练表现、比赛能力和位置特点说明" /></view><view class="between option" wx:if="{{role === 'admin'}}"><view><view>保留原普通班</view><view class="muted small">默认保留；关闭后原班关系标记为已退出</view></view><switch checked="{{keepSource}}" bindchange="keep" color="#12643b"/></view></view><view class="sticky-action"><button class="btn-primary" disabled="{{classes.length === 0}}" loading="{{saving}}" bindtap="submit">{{role === 'admin' ? '确认晋升' : '提交推荐'}}</button></view></view>
