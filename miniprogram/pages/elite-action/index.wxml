<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:else><view class="hint">教练只能提交推荐，最终入队决定由管理员审核；管理员可直接晋升。</view><view class="card"><view class="field"><text class="field-label">目标精英队 *</text><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="classChange"><view class="picker">{{classes[classIndex].name || '暂无可选精英队'}}</view></picker></view><view class="field"><text class="field-label">{{role === 'admin' ? '晋升依据' : '推荐理由'}} *</text><textarea class="textarea" value="{{reason}}" bindinput="field" placeholder="训练表现、比赛能力、位置特点等" /></view><view class="between option" wx:if="{{role === 'admin'}}"><view><view>保留原普通班</view><view class="muted small">关闭后将原班关系标记为已退出</view></view><switch checked="{{keepSource}}" bindchange="keep" color="#173B77"/></view></view><view class="sticky-action"><button class="btn-primary" loading="{{saving}}" bindtap="submit">{{role === 'admin' ? '确认晋升' : '提交推荐'}}</button></view></view>
