page{background:linear-gradient(165deg,#edf5f0 0%,#f8faf9 46%,#eef2f8 100%)}
.auth-shell{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 64rpx) 42rpx calc(46rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:center}
.brand{text-align:center;margin-bottom:42rpx}
.logo{width:146rpx;height:174rpx}
.club-name{margin-top:16rpx;color:#12643b;font-size:28rpx;font-weight:700;letter-spacing:2rpx}
.product-name{font-size:52rpx;line-height:1.2;font-weight:900;color:#173b77;margin-top:14rpx}
.welcome{color:#747d78;font-size:26rpx;line-height:1.5;margin-top:14rpx}
.panel{width:100%;max-width:680rpx;margin:0 auto;background:rgba(255,255,255,.96);border:1rpx solid rgba(255,255,255,.8);border-radius:30rpx;padding:38rpx 34rpx;box-shadow:0 18rpx 54rpx rgba(25,67,47,.1)}
button{border:0;font-size:28rpx;font-weight:700}
.primary,.secondary,.phone-button{width:100%;min-height:88rpx;height:auto;margin-left:0;margin-right:0;padding:22rpx 28rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.25}
.primary{background:#173b77;color:#fff;box-shadow:0 10rpx 24rpx rgba(23,59,119,.18)}
.secondary{background:#eaf0f9;color:#173b77}
.phone-button{background:#eaf1ff;color:#173b77;margin-bottom:18rpx}
.primary::after,.secondary::after,.phone-button::after{border:0}
.divider{height:auto;display:flex;align-items:center;justify-content:center;gap:20rpx;color:#919993;font-size:24rpx;margin:30rpx 0}
.divider text{height:2rpx;flex:1;background:#e6ebe8}
.staff-link{display:flex;align-items:center;justify-content:center;text-align:center;color:#173b77;font-size:26rpx;min-height:74rpx;padding:18rpx 8rpx 4rpx}
.panel-title{text-align:center;color:#173b77;font-weight:800;font-size:34rpx}
.panel-desc{text-align:center;color:#7c8580;font-size:24rpx;line-height:1.65;margin:14rpx 0 30rpx}
.field{margin-bottom:24rpx}
.field text{display:block;color:#434b47;font-size:25rpx;font-weight:700;margin-bottom:12rpx}
.field input{height:88rpx;box-sizing:border-box;padding:0 24rpx;border:2rpx solid #e9eef4;border-radius:16rpx;background:#f7f9fb}
.or{text-align:center;color:#a0a7a3;font-size:22rpx;margin-bottom:18rpx}
.back{text-align:center;color:#6e7872;font-size:26rpx;padding-top:30rpx}
.staff-state{text-align:center;color:#616b65;font-size:27rpx;line-height:1.7;padding:32rpx 10rpx}
.disabled{border-top:8rpx solid #d19a32}
.staff-auth{margin-top:28rpx;padding-top:24rpx;border-top:2rpx solid #edf0ee}
.staff-auth input{height:88rpx;box-sizing:border-box;padding:0 24rpx;text-align:center;letter-spacing:12rpx;border:2rpx solid #e9eef4;border-radius:16rpx;background:#f7f9fb;margin-bottom:18rpx}
.error{color:#b5463f;background:#fff0ee;border-radius:14rpx;padding:18rpx 22rpx;margin-top:20rpx;text-align:center;font-size:24rpx;line-height:1.55}
.privacy{text-align:center;color:#929b96;font-size:21rpx;line-height:1.55;margin:30rpx 28rpx 0}
@media (max-height:700px){.auth-shell{justify-content:flex-start;padding-top:calc(env(safe-area-inset-top) + 36rpx)}.brand{margin-bottom:28rpx}.logo{width:118rpx;height:142rpx}.panel{padding-top:30rpx;padding-bottom:30rpx}}
