<view class="page page-enter"><view class="hero brand-hero"><view class="eyebrow">NANLIAN BUSINESS CENTER</view><view class="title">财务与经营中心</view><view class="sub">订单、收款、退款与课时流水相互追溯</view></view><view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view><block wx:elif="{{data}}"><view class="metrics"><view><text>¥{{data.metrics.todayReceived}}</text><text>今日收款</text></view><view><text>¥{{data.metrics.monthReceived}}</text><text>本月收款</text></view><view><text>{{data.metrics.monthOrders}}</text><text>本月订单</text></view><view><text>¥{{data.metrics.monthRefunded}}</text><text>本月退款</text></view><view><text>{{data.metrics.pendingOrders}}</text><text>待收订单</text></view><view><text>{{data.metrics.renewalStudents}}</text><text>续费预警</text></view></view><view class="card pending"><view><view class="muted small">待收款金额</view><view class="amount">¥{{data.metrics.pendingAmount}}</view></view><button size="mini" bindtap="orders">进入订单中心</button></view><view class="quick"><view bindtap="products">课程产品</view><view bindtap="orders">订单与续费</view><view bindtap="adjustment">人工课时调整</view></view><view class="section-title">最近收款</view><view class="card row" wx:for="{{data.recentPayments}}" wx:key="id"><view><view>¥{{item.amount}} · {{item.paymentMethod}}</view><view class="muted small">{{item.receivedAt}}</view></view><text class="tag">已登记</text></view><view class="empty card" wx:if="{{!data.recentPayments.length}}">暂无收款</view><view class="section-title">最近退款</view><view class="card row" wx:for="{{data.recentRefunds}}" wx:key="id"><view><view>退款 ¥{{item.amount}}</view><view class="muted small">{{item.reason}} · {{item.processedAt}}</view></view><text class="tag warning">已退款</text></view><view class="empty card" wx:if="{{!data.recentRefunds.length}}">暂无退款</view></block></view>
