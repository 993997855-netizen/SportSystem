.hero{border-radius:28rpx;padding:34rpx}.eyebrow{font-size:19rpx;letter-spacing:2rpx;color:#e2bd52}.title{font-size:42rpx;font-weight:800;margin:10rpx 0}.sub{color:#dce6f6}.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:2rpx;background:#e7ebf2;border-radius:22rpx;overflow:hidden;margin:20rpx 0}.metrics view{background:#fff;padding:25rpx;text-align:center}.metrics text{display:block}.metrics text:first-child{font-size:34rpx;font-weight:800;color:#173b77}.metrics text:last-child{font-size:21rpx;color:#8490a2;margin-top:6rpx}.pending,.row{display:flex;align-items:center;justify-content:space-between}.amount{font-size:40rpx;font-weight:800;color:#c26b00;margin-top:6rpx}.pending button{background:#173b77;color:#fff}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.quick view{background:#fff;padding:22rpx 10rpx;text-align:center;border-radius:18rpx;color:#173b77;font-weight:700;font-size:24rpx}
