<view class="page page-enter"><view class="card"><view class="field"><text class="field-label">跟进方式</text><picker range="{{meta.methods}}" value="{{methodIndex}}" bindchange="method"><view class="picker">{{form.method}}</view></picker></view><view class="field"><text class="field-label">跟进结果</text><picker range="{{meta.results}}" value="{{resultIndex}}" bindchange="result"><view class="picker">{{form.result}}</view></picker></view><view class="field"><text class="field-label">跟进内容 *</text><textarea class="textarea" placeholder="记录家长需求、疑问和约定" value="{{form.content}}" bindinput="content"/></view><view class="field"><text class="field-label">下次跟进</text><view class="row"><picker class="grow" mode="date" value="{{form.nextDate}}" bindchange="date"><view class="picker">{{form.nextDate}}</view></picker><picker class="grow time" mode="time" value="{{form.nextTime}}" bindchange="time"><view class="picker">{{form.nextTime}}</view></picker></view></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存跟进记录</button></view>
