<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:elif="{{detail}}"><view class="hero brand-hero"><view class="title">{{detail.name}}</view><view class="sub">{{detail.assessmentDate}} · {{detail.template.name}}</view><view class="progress-text">已完成 {{detail.completed}} / {{detail.expected}}</view></view><view class="section-title">正式成员名单</view><view class="card student pressable" wx:for="{{detail.students}}" wx:key="id" data-student="{{item.id}}" data-index="{{index}}" bindtap="assess"><image wx:if="{{item.avatarUrl}}" class="avatar photo" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{item.initial}}</view><view class="grow"><view class="name">{{item.name}}</view><view class="muted small">{{item.assessmentStatus === 'COMPLETED' ? '已完成' : item.assessmentStatus === 'DRAFT' ? '草稿' : '未开始'}}</view></view><view class="tag {{item.assessmentStatus === 'COMPLETED' ? '' : 'gold'}}">录入 ›</view></view><view class="sticky-action" wx:if="{{role === 'admin'}}"><button class="btn-primary" loading="{{publishing}}" bindtap="publish">{{detail.status === 'COMPLETED' ? '重新发布修订结果' : '发布测评'}}</button></view></view>
