.hero{padding:34rpx;border-radius:28rpx}.title{font-size:42rpx;font-weight:800;margin:8rpx 0}.eyebrow{opacity:.7;font-size:22rpx}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:20rpx 0}.metrics view{background:#fff;border-radius:18rpx;padding:22rpx 8rpx;text-align:center}.metrics text{display:block}.metrics text:first-child{font-size:38rpx;font-weight:800;color:#173b77}.metrics text:last-child{font-size:21rpx;color:#7a817d}.nav{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.nav view{background:#fff;border-radius:20rpx;padding:25rpx}.nav text{display:block}.nav text:first-child{font-weight:800;color:#173b77}.nav text:last-child{font-size:22rpx;color:#7a817d;margin-top:8rpx}.tag-row{display:grid;grid-template-columns:130rpx 1fr 70rpx;align-items:center;gap:12rpx}.bar{height:14rpx;background:#edf1ee;border-radius:10rpx;overflow:hidden}.bar view{height:100%;background:#12643b}.notice{color:#80561c;background:#fff3e2;padding:20rpx;border-radius:16rpx}
