<view class="page"><picker mode="date" fields="month" value="{{month}}" bindchange="month"><view class="month">统计月份：{{month}} 〉</view></picker><view class="card" wx:for="{{data.rows}}" wx:key="coach.id"><view class="head"><image wx:if="{{item.coach.avatarUrl}}" src="{{item.coach.avatarUrl}}" mode="aspectFill"/><view><view class="name">{{item.coach.name}}</view><view class="muted">实授 {{item.actualCount}} 节 · {{item.durationMinutes}} 分钟</view></view></view><view class="grid"><view><text>{{item.headCount}}</text><text>主教练</text></view><view><text>{{item.assistantCount}}</text><text>助理</text></view><view><text>{{item.substituteCount}}</text><text>代课</text></view><view><text>{{item.cancelledCount}}</text><text>取消</text></view></view><view class="note">赛事带队 {{item.matchCoachCount}} 次（独立统计，不计入训练课时）</view></view></view>
