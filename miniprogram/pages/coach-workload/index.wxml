<view class="page"><view class="brand-hero work-head" wx:if="{{role === 'coach'}}"><view class="eyebrow">MY WORK</view><view class="title">我的工作</view><view class="sub">课时、训练计划和教练资料集中在这里</view></view><view class="work-links" wx:if="{{role === 'coach'}}"><view class="card pressable" bindtap="plans"><text>本周训练计划</text><text class="link">查看 ›</text></view><view class="card pressable" bindtap="profile"><text>我的教练资料</text><text class="link">查看 ›</text></view></view><picker mode="date" fields="month" value="{{month}}" bindchange="month"><view class="month">{{role === 'coach' ? '本月课时' : '课时统计'}}：{{month}} 〉</view></picker><view class="card" wx:for="{{data.rows}}" wx:key="coach.id"><view class="head"><image wx:if="{{item.coach.avatarUrl}}" src="{{item.coach.avatarUrl}}" mode="aspectFill"/><view><view class="name">{{item.coach.name}}</view><view class="muted">实授 {{item.actualCount}} 节 · {{item.durationMinutes}} 分钟</view></view></view><view class="grid"><view><text>{{item.headCount}}</text><text>主教练</text></view><view><text>{{item.assistantCount}}</text><text>助理</text></view><view><text>{{item.substituteCount}}</text><text>代课</text></view><view><text>{{item.cancelledCount}}</text><text>取消</text></view></view><view class="note">赛事带队 {{item.matchCoachCount}} 次（单独统计，不计入训练课时）</view></view><view class="empty card" wx:if="{{!loading && (!data.rows || data.rows.length === 0)}}">本月暂无课时记录</view><view class="card muted small" wx:if="{{data.incomeAvailable === false}}">{{data.incomeMessage}}</view></view>
