.month,.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:18rpx}.head{display:flex;align-items:center;gap:18rpx}.head image{width:82rpx;height:82rpx;border-radius:50%}.name{font-size:30rpx;font-weight:800}.muted,.note{font-size:23rpx;color:#7a817d}.grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:24rpx;background:#f5f7f6;border-radius:16rpx}.grid view{padding:18rpx 4rpx;text-align:center}.grid text{display:block}.grid text:first-child{font-size:32rpx;color:#173b77;font-weight:800}.grid text:last-child{font-size:21rpx;color:#7a817d}.note{margin-top:16rpx}
