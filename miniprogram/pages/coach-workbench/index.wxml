<view class="page"><view class="brand-hero"><view class="eyebrow">TODAY'S COACHING</view><view class="title">今日教学</view><view class="sub">看安排、点名和填写课后记录，都从这里开始</view></view><view class="range-tabs"><text class="{{range === 'today' ? 'active' : ''}}" data-range="today" bindtap="range">今天</text><text class="{{range === 'week' ? 'active' : ''}}" data-range="week" bindtap="range">本周</text><text class="{{range === 'all' ? 'active' : ''}}" data-range="all" bindtap="range">全部</text></view><view class="week-nav" wx:if="{{range !== 'today'}}"><text bindtap="previous">‹ 上一周</text><text bindtap="current" class="current">本周</text><text bindtap="next">下一周 ›</text></view><view class="tools"><text bindtap="weeklyPlan">本周训练计划 〉</text><text bindtap="workload">我的工作 〉</text></view><view class="loading-state" wx:if="{{loading}}">加载中</view><view class="empty card" wx:elif="{{error}}">{{error}}<view class="link" bindtap="load">重新加载</view></view><block wx:else><view class="day" wx:for="{{groups}}" wx:key="date"><view class="day-title">{{item.isToday ? '今天 · ' : ''}}{{item.date}}</view><view class="timeline"><view class="card course" wx:for="{{item.items}}" wx:for-item="course" wx:key="id" data-id="{{course.sessionId}}" data-type="{{course.sourceType}}" bindtap="open"><view class="time">{{course.time}}</view><view class="between"><view class="name">{{course.className}}</view><view class="tag {{course.isSubstitute ? 'substitute' : ''}}">{{course.sourceType === 'MATCH' ? '比赛' : course.coachRoleLabel}}</view></view><view class="meta">{{course.venue}}</view><view class="theme">本节重点：{{course.trainingTheme || '待填写'}}</view><view class="original" wx:if="{{course.isSubstitute && course.originalCoachText}}">原计划：{{course.originalCoachText}}</view><view class="status">{{course.statusLabel}}</view><view class="course-actions" wx:if="{{course.sourceType === 'TRAINING'}}"><button size="mini" class="btn-primary" data-id="{{course.sessionId}}" catchtap="attendance">开始点名</button><button size="mini" class="btn-secondary" data-id="{{course.sessionId}}" catchtap="evaluation">课后记录</button></view></view></view></view><view class="empty card" wx:if="{{!groups.length}}">{{range === 'today' ? '今天暂无训练安排' : '当前暂无已安排课程'}}</view></block></view>
