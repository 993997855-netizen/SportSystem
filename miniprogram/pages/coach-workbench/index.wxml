<view class="page"><view class="brand-hero"><view class="eyebrow">MY TIMETABLE</view><view class="title">我的课表</view><view class="sub">只显示我主教、助教、代课或带队的安排</view></view><view class="week-nav"><text bindtap="previous">‹ 上一周</text><text bindtap="current" class="current">本周</text><text bindtap="next">下一周 ›</text></view><view class="stats"><view><text>{{timetable.stats.total || 0}}</text><text>本周课程</text></view><view><text>{{timetable.stats.head || 0}}</text><text>主教练</text></view><view><text>{{timetable.stats.assistant || 0}}</text><text>助教</text></view><view><text>{{timetable.stats.substitute || 0}}</text><text>代课</text></view></view><view class="tools"><text bindtap="today">今天</text><text bindtap="workload">课时统计 〉</text></view><view class="loading-state" wx:if="{{loading}}">加载中</view><view class="empty card" wx:elif="{{error}}">{{error}}<view class="link" bindtap="load">重新加载</view></view><block wx:else><view class="day" wx:for="{{groups}}" wx:key="date"><view class="day-title">{{item.isToday ? '今天 · ' : ''}}{{item.date}}</view><view class="timeline"><view class="card course" wx:for="{{item.items}}" wx:for-item="course" wx:key="id" data-id="{{course.sessionId}}" data-type="{{course.sourceType}}" bindtap="open"><view class="time">{{course.time}}</view><view class="between"><view class="name">{{course.className}}</view><view class="tag {{course.isSubstitute ? 'substitute' : ''}}">{{course.sourceType === 'MATCH' ? '比赛' : course.coachRoleLabel}}</view></view><view class="meta">{{course.venue}}</view><view class="theme">训练主题：{{course.trainingTheme}}</view><view class="original" wx:if="{{course.isSubstitute && course.originalCoachText}}">原计划：{{course.originalCoachText}}</view><view class="status">{{course.statusLabel}}</view></view></view></view><view class="empty card" wx:if="{{!groups.length}}">本周暂无安排</view></block></view>
