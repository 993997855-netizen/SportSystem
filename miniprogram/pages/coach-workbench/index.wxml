<view class="page"><view class="hero brand-hero"><view>今日课程</view><view class="date">{{data.date}}</view></view><view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="card session" wx:for="{{data.sessions}}" wx:key="id"><view class="time">{{item.date}} {{item.time}}</view><view class="title">{{item.title}}</view><view class="theme">训练主题：{{item.trainingTheme}}</view><view class="focus">训练重点：{{item.trainingFocusText || '待填写'}}</view><view class="muted small">{{item.memberCount}}名正式成员 · {{item.leaveCount}}人请假 · {{item.venue}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" bindtap="course">查看课程</button><button size="mini" data-id="{{item.id}}" bindtap="attendance">开始点名</button><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑训练重点</button></view></view></view>
