.hero{border-radius:28rpx;padding:30rpx}.date{font-size:42rpx;font-weight:800;margin:10rpx 0}.stats{display:flex;gap:28rpx;opacity:.85}.session .title{font-size:32rpx;font-weight:800;margin-top:8rpx}.time{color:#7a817d;font-size:23rpx}.theme{color:#12643b;font-weight:700;margin:22rpx 0 10rpx}.equipment text{display:inline-block;background:#fff3e2;color:#80561c;padding:6rpx 12rpx;border-radius:12rpx;margin:14rpx 8rpx 0 0;font-size:21rpx}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:20rpx}.actions button{padding:0;font-size:22rpx;background:#eaf0f9;color:#173b77}
.focus{margin-bottom:12rpx;color:#59645e}
