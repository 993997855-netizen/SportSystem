<view class="page"><view class="card"><view class="field"><text class="field-label">大纲名称</text><input class="input" value="{{form.name}}" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">年龄组</text><input class="input" value="{{form.ageGroup}}" placeholder="如：U7-U8" data-key="ageGroup" bindinput="field"/></view><view class="between field"><text>精英队大纲</text><switch checked="{{form.classType === 'ELITE'}}" bindchange="type" color="#173b77"/></view><view class="field"><text class="field-label">排序（数字越小越靠前）</text><input class="input" type="number" value="{{form.sortOrder}}" data-key="sortOrder" bindinput="field"/></view><view class="field"><text class="field-label">训练项目</text><checkbox-group bindchange="topics"><label class="topic" wx:for="{{topics}}" wx:key="key"><checkbox value="{{item.key}}" checked="{{item.checked}}" color="#12643b"/>{{item.name}}</label></checkbox-group></view><view class="field"><text class="field-label">长期目标</text><textarea class="textarea" value="{{form.objectivesText}}" data-key="objectivesText" bindinput="field"/></view><view class="field"><text class="field-label">说明</text><textarea class="textarea" value="{{form.description}}" data-key="description" bindinput="field"/></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存训练大纲</button><button wx:if="{{id}}" class="btn-secondary archive" bindtap="changeStatus">{{form.active === false ? '恢复大纲' : '停用大纲'}}</button></view>
