<view class="hero">
  <view class="hero-top"><image class="club-logo" src="/images/nanlian-logo.png" mode="aspectFit"/><view class="grow"><view class="eyebrow">NANLIAN FOOTBALL CLUB</view><view class="hello">你好，{{user.name || '南联家人'}}</view><view class="hero-sub">{{roleLabel}} · 训练有标准，成长有记录</view></view></view>
</view>
<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter content" wx:else>
  <picker wx:if="{{dashboard.role === 'parent' && familyStudents.length > 1}}" range="{{familyStudents}}" range-key="name" value="{{activeStudentIndex}}" bindchange="activeStudentChange"><view class="card child-switch"><image wx:if="{{familyStudents[activeStudentIndex].avatarUrl}}" src="{{familyStudents[activeStudentIndex].avatarUrl}}" mode="aspectFill"/><view wx:else class="switch-fallback">{{familyStudents[activeStudentIndex].initial}}</view><view class="grow"><view class="muted small">当前孩子</view><view>{{familyStudents[activeStudentIndex].name}}</view></view><text class="link">切换 ▾</text></view></picker>
  <view class="card parent-empty" wx:if="{{parentEmpty}}">
    <view class="empty-ball">⚽</view><view class="empty-title">欢迎加入南联</view>
    <view class="empty-copy">您还没有添加孩子信息</view>
    <view class="empty-benefits"><view>添加孩子后，可以查看：</view><view>课程 · 课表 · 请假 · 成长档案 · 比赛安排</view></view>
    <button class="btn-primary add-child" bindtap="goAddChild">＋ 添加孩子</button>
  </view>
  <block wx:else>
  <view class="stats"><view class="stat pressable" bindtap="goStudents"><text class="stat-value">{{dashboard.studentCount}}</text><text class="stat-label">{{dashboard.role === 'coach' ? '我的学员' : '学员'}}</text></view><view class="stat pressable" bindtap="goSessions"><text class="stat-value">{{dashboard.sessions.length}}</text><text class="stat-label">近期课程</text></view><view class="stat pressable" bindtap="goClasses"><text class="stat-value {{dashboard.role === 'coach' ? '' : 'warn'}}">{{dashboard.role === 'coach' ? dashboard.classCount : dashboard.lowBalance}}</text><text class="stat-label">{{dashboard.role === 'coach' ? '我的班级' : '课时不足'}}</text></view><view class="stat pressable" bindtap="goLeaves"><text class="stat-value">{{dashboard.pendingLeaves}}</text><text class="stat-label">待审请假</text></view></view>
  <view class="section-title">快捷入口</view><view class="quick-grid"><view class="quick pressable" wx:for="{{quickEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="openQuick"><view class="quick-icon {{item.tone}}">{{item.icon}}</view><text>{{item.label}}</text></view></view>
  <view class="section-title" wx:if="{{dashboard.role === 'admin'}}">今日课程</view><view class="notice card pressable" wx:if="{{dashboard.role === 'admin'}}" bindtap="goTimetable"><view class="notice-title">今日 {{todayScheduleStats.total}} 节</view><view>进行中 {{todayScheduleStats.inProgress}} · 待开始 {{todayScheduleStats.upcoming}}</view><view class="muted small">进入南联课程总表 ›</view></view>
  <view class="section-title" wx:if="{{nextSchedule}}">{{dashboard.role === 'admin' ? '下一课程' : dashboard.role === 'coach' ? '下一节课' : '下一安排'}}</view><view class="notice card pressable" wx:if="{{nextSchedule}}" bindtap="openNext"><view class="notice-title">{{nextSchedule.studentName ? nextSchedule.studentName + ' · ' : ''}}{{nextSchedule.className}}</view><view>{{nextSchedule.date}} {{nextSchedule.time}} · {{nextSchedule.venue}}</view><view class="muted small">{{nextSchedule.sourceLabel}} · {{nextSchedule.primaryCoach.name || '教练待定'}} · 查看课表 ›</view></view>
  <view class="notice card pressable" bindtap="goNews"><view class="notice-title">俱乐部公告</view><view>查看最新训练安排、活动和课程通知。</view></view>
  <view class="between section-row"><view class="section-title">近期课程</view><text class="link" bindtap="goSessions">全部 ›</text></view><view class="card class-card" wx:for="{{dashboard.sessions}}" wx:key="id"><view class="grow"><view class="class-name">{{item.title}}</view><view class="muted small class-meta">{{item.date}} {{item.time}} · {{item.venue}}</view><view class="small">{{item.focus}} · 正式成员 {{item.memberCount}} / 标准人数 {{item.standardCapacity}}</view></view><button wx:if="{{dashboard.role !== 'parent'}}" class="mini-btn" data-id="{{item.id}}" bindtap="takeAttendance">点名</button><view wx:else class="tag">{{item.myStatus === 'booked' ? '正式成员' : item.myStatus === 'leave_pending' ? '请假待审批' : item.myStatus === 'leave_approved' ? '已请假' : item.myStatus === 'leave_rejected' ? '请假被拒绝' : item.classType === 'ELITE' ? '选拔制' : item.isFull ? '本班已满' : '可报名'}}</view></view><view class="empty card" wx:if="{{dashboard.sessions.length === 0}}">暂无已发布课程</view>
  <view class="section-title">{{dashboard.role === 'coach' ? '我的学员' : dashboard.role === 'parent' ? '孩子课时' : '低课时提醒'}}</view><view class="card pressable student-row" wx:for="{{dashboard.recentStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="goStudent"><image wx:if="{{item.avatarUrl}}" class="avatar student-photo" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{item.initial}}</view><view class="grow"><view class="student-name">{{item.name}}</view><view class="muted small">{{item.classNames || (dashboard.role === 'coach' ? (item.birthDate || item.school) : item.guardianName)}}</view></view><view wx:if="{{dashboard.role !== 'coach'}}" class="balance {{item.lowBalance ? 'low' : ''}}"><text>{{item.remainingLessons}}</text><text class="small">节</text></view></view>
  </block>
</view>
