<view class="hero">
  <view class="between">
    <view>
      <view class="eyebrow">{{today}}</view>
      <view class="hello">你好，{{user.name || '用户'}}</view>
      <view class="hero-sub">{{roleLabel}}工作台</view>
    </view>
    <view class="ball">⚽</view>
  </view>
</view>

<view class="loading-state" wx:if="{{loading}}"><view><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="small">正在加载工作台</view></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter content" wx:else>
  <view class="stats">
    <view class="stat pressable" bindtap="goStudents"><text class="stat-value">{{dashboard.studentCount}}</text><text class="stat-label">在读学员</text></view>
    <view class="stat pressable" bindtap="goClasses"><text class="stat-value">{{dashboard.classCount}}</text><text class="stat-label">当前班级</text></view>
    <view class="stat pressable" bindtap="goStudents"><text class="stat-value warn">{{dashboard.lowBalance}}</text><text class="stat-label">课时不足</text></view>
    <view class="stat pressable" bindtap="goStat4"><text class="stat-value">{{stat4Value}}</text><text class="stat-label">{{stat4Label}}</text></view>
  </view>

  <view class="section-title">快捷操作</view>
  <view class="quick-grid">
    <view class="quick pressable" wx:if="{{dashboard.role !== 'parent'}}" bindtap="goClasses"><view class="quick-icon green">✓</view><text>上课点名</text></view>
    <view class="quick pressable" wx:else bindtap="goRenewals"><view class="quick-icon green">＋</view><text>课时续费</text></view>
    <view class="quick pressable" bindtap="goStudents"><view class="quick-icon blue">人</view><text>{{dashboard.role === 'parent' ? '孩子档案' : '学员档案'}}</text></view>
    <view class="quick pressable" wx:if="{{dashboard.role !== 'coach'}}" bindtap="goRenewals"><view class="quick-icon orange">¥</view><text>续费记录</text></view>
    <view class="quick pressable" wx:else bindtap="goStudents"><view class="quick-icon orange">!</view><text>课时提醒</text></view>
  </view>

  <view class="section-title">我的班级</view>
  <view class="card class-card" wx:for="{{dashboard.classes}}" wx:key="id">
    <view class="between">
      <view class="grow">
        <view class="class-name">{{item.name}}</view>
        <view class="muted small class-meta">{{item.schedule}} · {{item.venue}}</view>
        <view class="small">教练：{{item.coachName}}</view>
      </view>
      <button wx:if="{{dashboard.role !== 'parent'}}" class="mini-btn" data-id="{{item.id}}" bindtap="takeAttendance">点名</button>
    </view>
  </view>
  <view class="empty card" wx:if="{{dashboard.classes.length === 0}}">暂无已分配班级</view>

  <view class="section-title">{{attentionTitle}}</view>
  <view class="card pressable student-row" wx:for="{{dashboard.recentStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="goStudent">
    <view class="avatar">{{item.initial}}</view>
    <view class="grow"><view class="student-name">{{item.name}}</view><view class="muted small">家长：{{item.guardianName}}</view></view>
    <view class="balance {{item.remainingLessons <= 5 ? 'low' : ''}}"><text>{{item.remainingLessons}}</text><text class="small">节</text></view>
  </view>
  <view class="empty card" wx:if="{{dashboard.recentStudents.length === 0}}">暂无学员数据</view>
</view>
