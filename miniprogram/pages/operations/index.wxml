<view class="page page-enter">
  <view class="admin-head brand-hero"><view class="eyebrow">NANLIAN OPERATIONS</view><view class="title">运营驾驶舱</view><view class="sub">数据留痕 · 权限分开 · 异常闭环</view></view>
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
  <block wx:else>
    <view class="metrics"><view><text>{{data.metrics.students}}</text><text>学员</text></view><view><text>{{data.metrics.sessions}}</text><text>课程</text></view><view><text>{{data.metrics.booked}}</text><text>报名</text></view><view><text>{{data.metrics.waiting}}</text><text>历史候补</text></view><view><text>{{data.metrics.pendingLeaves}}</text><text>待审请假</text></view><view><text>{{data.metrics.pendingRenewals}}</text><text>待确认续费</text></view></view>
    <view class="section-title">快捷管理</view><view class="quick"><view bindtap="addSession">＋ 发布课程</view><view bindtap="classes">▦ 班级管理</view><view bindtap="leaves">✓ 请假审核</view><view bindtap="renewals">¥ 续费确认</view></view>
    <view class="section-title">运营预警</view><view class="card alert {{item.level}}" wx:for="{{data.alerts}}" wx:key="text"><text>!</text><view>{{item.text}}</view></view>
    <view class="section-title">近期课程</view><view class="card session" wx:for="{{data.sessions}}" wx:key="id"><view class="grow"><view class="name">{{item.title}}</view><view class="muted small">{{item.date}} {{item.time}} · {{item.venue}}</view><view class="small mt">报名 {{item.enrolledCount}}/{{item.capacity}}</view></view><button size="mini" data-id="{{item.id}}" bindtap="attendance">点名</button></view>
    <view class="section-title">最近操作记录</view><view class="card log" wx:for="{{data.auditLogs}}" wx:key="id"><view><view>{{item.action}} · {{item.targetType}}</view><view class="muted small">{{item.detail}}</view></view><text class="muted small">{{item.createdAt}}</text></view><view class="empty card" wx:if="{{data.auditLogs.length === 0}}">暂无操作记录</view>
  </block>
</view>
