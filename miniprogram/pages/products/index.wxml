<view class="page"><view class="notice">产品定义俱乐部卖什么；修改价格只影响新订单，历史订单保留购买时快照。</view><view class="card product" wx:for="{{rows}}" wx:key="id"><view class="grow" data-id="{{item.id}}" bindtap="edit"><view class="between"><view class="name">{{item.name}}</view><view class="price">¥{{item.price}}</view></view><view class="muted small">{{item.productTypeLabel}} · {{item.lessonCount}}节 · 有效{{item.validityDays || '不限'}}天</view><view class="muted small mt">{{item.description || '暂无说明'}}</view></view><switch checked="{{item.active}}" data-id="{{item.id}}" bindchange="toggle" color="#12643b"/></view><floating-add-button bind:add="add"/></view>
