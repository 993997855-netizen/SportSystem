<view class="page"><view class="card"><view class="between"><view><view class="field-label">外部邀请球队</view><view class="muted small">外部球队不要求关联南联班级</view></view><switch checked="{{organizationType === 'EXTERNAL'}}" bindchange="type" color="#173b77"/></view><view class="field"><text class="field-label">球队名称</text><input class="input" value="{{name}}" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">组织名称</text><input class="input" value="{{organizationName}}" data-key="organizationName" bindinput="field"/></view><view class="field"><text class="field-label">出生年份组</text><input class="input" value="{{birthYears}}" data-key="birthYears" bindinput="field"/></view><block wx:if="{{organizationType === 'EXTERNAL'}}"><view class="field"><text class="field-label">联系人</text><input class="input" value="{{contactName}}" data-key="contactName" bindinput="field"/></view><view class="field"><text class="field-label">联系电话</text><input class="input" type="number" value="{{contactMobile}}" data-key="contactMobile" bindinput="field"/></view></block><view class="field"><text class="field-label">教练</text><input class="input" value="{{coachName}}" data-key="coachName" bindinput="field"/></view><block wx:if="{{organizationType === 'INTERNAL'}}"><view class="field"><text class="field-label">关联班级ID</text><input class="input" value="{{classId}}" data-key="classId" bindinput="field"/></view><view class="field"><text class="field-label">首位内部球员</text><picker range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="student"><view class="picker">{{students[studentIndex].name || '请选择'}}</view></picker></view><view class="field"><text class="field-label">球衣号码</text><input class="input" type="number" value="{{jerseyNumber}}" data-key="jerseyNumber" bindinput="field"/></view></block></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存并加入赛季</button></view>
