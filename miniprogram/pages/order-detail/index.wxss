.hero{border-radius:26rpx;padding:30rpx}.muted-light{color:#cdd9eb}.order-no{font-size:30rpx;font-weight:800}.product{font-size:38rpx;font-weight:800;margin:22rpx 0 8rpx}.line{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #edf0f4}.line:last-child{border:0}.strong{font-weight:800;color:#c26b00}.actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.record{display:flex;justify-content:space-between;align-items:center}.delta{font-size:30rpx;font-weight:800}.plus{color:#12643b}.minus{color:#b94343}.mask{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:10}.sheet{position:fixed;left:0;right:0;bottom:0;background:#fff;z-index:11;border-radius:30rpx 30rpx 0 0;padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));max-height:82vh;overflow:auto}.sheet-title{font-size:34rpx;font-weight:800;margin-bottom:24rpx}
