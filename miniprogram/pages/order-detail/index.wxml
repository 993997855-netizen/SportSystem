<view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="page" wx:elif="{{order}}"><view class="hero brand-hero"><view class="between"><view><view class="muted-light small">订单号</view><view class="order-no">{{order.orderNo}}</view></view><view class="tag gold">{{order.statusLabel}}</view></view><view class="product">{{order.productName}}</view><view>{{order.studentName}} · {{order.lessonCount}}节</view></view><view class="card"><view class="line"><text class="muted">订单金额</text><text>¥{{order.payableAmount}}</text></view><view class="line"><text class="muted">已收款</text><text>¥{{order.paidAmount}}</text></view><view class="line"><text class="muted">已退款</text><text>¥{{order.refundedAmount || 0}}</text></view><view class="line"><text class="muted">待收款</text><text class="strong">¥{{order.outstandingAmount}}</text></view><view class="line"><text class="muted">当前课时</text><text>{{order.remainingLessons}}节</text></view></view><view class="actions" wx:if="{{role === 'admin'}}"><button class="btn-primary" wx:if="{{order.status === 'PENDING' || order.status === 'PARTIAL_PAID'}}" bindtap="openPayment">登记收款</button><button class="btn-secondary" wx:if="{{order.status === 'PAID' || order.status === 'PARTIAL_REFUNDED'}}" bindtap="openRefund">办理退款</button><button class="btn-secondary" wx:if="{{order.status === 'PENDING' && !order.paidAmount}}" bindtap="cancelOrder">取消订单</button></view><view class="section-title">收款记录</view><view class="card record" wx:for="{{order.payments}}" wx:key="id"><view><view>¥{{item.amount}} · {{item.paymentMethod}}</view><view class="muted small">{{item.receivedAt}} · {{item.transactionRef || '无交易单号'}}</view></view><text class="tag">已收</text></view><view class="empty card" wx:if="{{!order.payments.length}}">暂无收款</view><view class="section-title">退款记录</view><view class="card record" wx:for="{{order.refunds}}" wx:key="id"><view><view>¥{{item.amount}} · 扣回{{item.lessonAdjustment}}节</view><view class="muted small">{{item.reason}} · {{item.processedAt}}</view></view><text class="tag warning">退款</text></view><view class="section-title">关联课时流水</view><view class="card record" wx:for="{{order.lessonLedger}}" wx:key="id"><view><view>{{item.note}}</view><view class="muted small">{{item.createdAt}} · 余额{{item.balanceAfter}}</view></view><text class="delta {{item.delta > 0 ? 'plus' : 'minus'}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text></view><view class="empty card" wx:if="{{!order.lessonLedger.length}}">订单尚未产生课时流水</view></view><view class="mask" wx:if="{{formMode}}" bindtap="close"></view><view class="sheet" wx:if="{{formMode}}"><view class="sheet-title">{{formMode === 'PAYMENT' ? '登记手工收款' : '办理订单退款'}}</view><view class="field"><text class="field-label">金额 *</text><input class="input" type="digit" value="{{form.amount}}" data-key="amount" bindinput="field"/></view><block wx:if="{{formMode === 'PAYMENT'}}"><view class="field"><text class="field-label">收款方式</text><picker range="{{paymentMethods}}" range-key="name" value="{{methodIndex}}" bindchange="method"><view class="picker">{{paymentMethods[methodIndex].name}}</view></picker></view><view class="field"><text class="field-label">交易单号（用于防重复）</text><input class="input" value="{{form.transactionRef}}" data-key="transactionRef" bindinput="field"/></view><view class="field"><text class="field-label">备注</text><input class="input" value="{{form.remark}}" data-key="remark" bindinput="field"/></view><button class="btn-primary" loading="{{saving}}" bindtap="submitPayment">确认登记收款</button></block><block wx:else><view class="field"><text class="field-label">同步扣回课时</text><input class="input" type="number" value="{{form.lessonAdjustment}}" data-key="lessonAdjustment" bindinput="field"/><view class="muted small">退款不会删除原+课流水，而是新增负向调整流水</view></view><view class="field"><text class="field-label">退款原因 *</text><textarea class="textarea" value="{{form.reason}}" data-key="reason" bindinput="field"/></view><button class="btn-primary" loading="{{saving}}" bindtap="submitRefund">确认退款</button></block></view>
