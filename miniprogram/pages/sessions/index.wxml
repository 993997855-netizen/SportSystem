<view class="page page-enter">
  <view class="schedule-head brand-hero">
  <view><view class="eyebrow">NANLIAN FOOTBALL CLUB</view><view class="title">{{pageTitle}}</view><view class="sub">{{role === 'parent' ? (viewMode === 'classes' ? '正式班级归属' : (viewMode === 'courses' ? '已发布训练课程' : '班级归属与已发布训练安排')) : (role === 'coach' ? '本人课程 · 训练考勤' : '统一发布 · 统一管理')}}</view></view>
    <image class="logo" src="/images/nanlian-logo.png" mode="aspectFit" />
  </view>
  <picker wx:if="{{role === 'parent' && students.length > 1}}" mode="selector" range="{{studentChoices}}" range-key="name" value="{{studentIndex}}" bindchange="studentChange"><view class="card student-picker"><view class="picker-fallback">{{studentId === 'ALL' ? '全' : '孩'}}</view><view class="grow"><view class="muted small">查看课程</view><view>{{studentChoices[studentIndex].name}}</view></view><text>切换 ›</text></view></picker>
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
  <view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
  <block wx:else>
    <view class="card next-training pressable" wx:if="{{role === 'parent' && nextSession}}" data-id="{{nextSession.id}}" data-student="{{nextSession.studentId}}" bindtap="open"><view class="muted small">下一次训练{{nextSession.studentName ? ' · ' + nextSession.studentName : ''}}</view><view class="next-title">{{nextSession.weekday}} {{nextSession.shortDate}} · {{nextSession.time}}</view><view>{{nextSession.title}}</view><view class="muted small">{{nextSession.venue}} · {{nextSession.coach.name || nextSession.coachName || '教练待定'}}</view><view class="link next-link">查看课程 ›</view></view>
    <view class="course-tools" wx:if="{{role === 'parent'}}"><button class="btn-secondary" bindtap="timetable">完整课表</button><button class="btn-secondary" bindtap="enrollment">班级报名</button></view>
    <block wx:if="{{role === 'parent' && viewMode !== 'courses'}}">
      <view class="section-title">我的班级</view>
      <view class="card my-class pressable" wx:for="{{myClasses}}" wx:key="rowKey" data-id="{{item.id}}" data-student="{{item.studentId}}" bindtap="openClass"><view class="between"><view><view class="name">{{item.name}}</view><view class="muted small" wx:if="{{studentId === 'ALL'}}">{{item.studentName}}</view><view class="muted small class-meta">{{item.schedule || '训练时间待发布'}} · {{item.venue || '场地待发布'}}</view></view><view><view class="tag">{{item.classTypeLabel}}</view><view class="member-label">正式成员 · 查看详情 ›</view></view></view></view>
      <view class="empty card" wx:if="{{myClasses.length === 0}}">暂未加入班级</view>
    </block>
    <block wx:if="{{role !== 'parent' || viewMode !== 'classes'}}">
    <view class="section-title">{{role === 'parent' ? '本周与近期课程' : (role === 'coach' ? '可考勤课程' : '课程列表')}}</view>
    <view class="card session pressable" wx:for="{{sessions}}" wx:key="rowKey" data-id="{{item.id}}" data-student="{{item.studentId}}" bindtap="open">
      <view class="between"><view class="date"><text>{{item.weekday}}</text><text>{{item.shortDate}}</text></view><view class="grow main"><view class="between"><view class="name">{{item.title}}</view><view class="tag {{item.myStatus === 'booked' ? '' : 'gold'}}">{{item.statusLabel}}</view></view><view class="muted small" wx:if="{{studentId === 'ALL'}}">{{item.studentName}}</view><view class="muted small meta">{{item.time}} · {{item.venue}}</view><view class="session-coach"><image wx:if="{{item.coach.avatarUrl}}" src="{{item.coach.avatarUrl}}" mode="aspectFill" /><view wx:else class="coach-avatar-fallback">教</view><text>{{item.coach.name || item.coachName}}</text></view><view class="focus">本次重点 · {{item.focus}}</view></view></view>
    </view>
    <view class="empty card no-session" wx:if="{{sessions.length === 0 && role === 'parent' && myClasses.length}}"><view>当前暂无新的训练安排</view><view class="muted small">新的课程安排发布后，会自动显示在“我的课表”中。</view></view>
    <view class="empty card" wx:elif="{{sessions.length === 0}}">{{role === 'parent' ? '加入班级后，可在这里查看训练安排' : (role === 'coach' ? '当前暂无可考勤课程' : '暂未发布课程')}}</view>
    </block>
  </block>
  <floating-add-button wx:if="{{role === 'admin'}}" bind:add="add" />
</view>
