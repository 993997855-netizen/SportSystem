<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:else><view class="card"><view class="field"><text class="field-label">目标班级</text><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="classChange"><view class="picker">{{classes[classIndex].name || '请选择'}}</view></picker></view><view class="field"><text class="field-label">调整原因</text><input class="input" value="{{reason}}" bindinput="field" /></view><view class="between option"><view><view>保留原班关系</view><view class="muted small">开启后学员会同时存在于两个班级</view></view><switch checked="{{keepSource}}" bindchange="keep" color="#173B77"/></view></view><view class="sticky-action"><button class="btn-primary" loading="{{saving}}" bindtap="submit">确认调整</button></view></view>
