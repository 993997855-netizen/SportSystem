.notice{padding:22rpx;border-radius:18rpx;background:#fff6da;color:#775b09;margin-bottom:20rpx}.member{display:flex;align-items:center;gap:18rpx}.check{width:46rpx;height:46rpx;border:2rpx solid #ccd6d0;border-radius:50%;text-align:center;line-height:44rpx;flex:0 0 auto}.member.selected{border:2rpx solid #173b77}.member.selected .check{background:#173b77;color:#fff}.player-photo{width:82rpx;height:82rpx;border-radius:50%;object-fit:cover;flex:0 0 auto}.player-photo.fallback{display:flex;align-items:center;justify-content:center;background:#eaf0f9;color:#173b77;font-weight:800}.player-name{font-weight:700}
