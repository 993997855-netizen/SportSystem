<view class="page"><view class="notice">固定比赛名单，不设置候补。不能参赛时由管理员或授权教练手工调整。</view><view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><block wx:else><view class="card member {{item.selected ? 'selected' : ''}}" wx:for="{{members}}" wx:key="memberId" data-index="{{index}}" bindtap="toggle"><image class="avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view class="check" wx:else>{{item.selected ? '✓' : ''}}</view><view class="grow"><view>{{item.name}}</view><view class="muted small">{{item.memberType === 'INTERNAL_STUDENT' ? '南联内部球员' : '外部参赛球员'}} · {{item.jerseyNumber || '-'}}号</view></view><view class="selected-label">{{item.selected ? '已选择' : '选择'}}</view></view><view class="empty card" wx:if="{{members.length === 0}}">球队尚未录入球员</view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存比赛名单</button></block></view>
