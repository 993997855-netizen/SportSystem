<view class="page"><view class="notice">固定比赛名单，不设置候补。孩子照片仅用于俱乐部内部身份确认。</view><view class="card member {{item.selected ? 'selected' : ''}}" wx:for="{{members}}" wx:key="memberId" data-index="{{index}}" bindtap="toggle"><view class="check">{{item.selected ? '✓' : ''}}</view><image wx:if="{{item.avatarUrl}}" class="player-photo" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="player-photo fallback">{{item.initial}}</view><view class="grow"><view class="player-name">{{item.name}}</view><view class="muted small">{{item.memberType === 'INTERNAL_STUDENT' ? '南联内部球员' : '外部参赛球员'}} · {{item.jerseyNumber}}号</view><view class="muted small" wx:if="{{item.birthDate}}">{{item.birthDate}}</view></view></view><view class="empty card" wx:if="{{members.length === 0}}">球队尚未录入球员</view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存比赛名单</button></view>
