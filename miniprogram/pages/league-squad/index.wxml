<view class="page"><view class="notice">固定比赛名单，不设置候补。不能参赛时由管理员手工调整。</view><view class="card member {{item.selected ? 'selected' : ''}}" wx:for="{{members}}" wx:key="memberId" data-index="{{index}}" bindtap="toggle"><view class="check">{{item.selected ? '✓' : ''}}</view><view class="grow"><view>{{item.name}}</view><view class="muted small">{{item.memberType === 'INTERNAL_STUDENT' ? '南联内部球员' : '外部参赛球员'}} · {{item.jerseyNumber}}号</view></view></view><view class="empty card" wx:if="{{members.length === 0}}">球队尚未录入球员</view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存比赛名单</button></view>
