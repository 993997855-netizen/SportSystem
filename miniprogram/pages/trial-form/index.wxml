<view class="page page-enter"><view class="card"><view class="field"><text class="field-label">优先绑定逐节课程</text><picker range="{{sessions}}" range-key="title" value="{{sessionIndex}}" bindchange="session"><view class="picker">{{sessions.length ? sessions[sessionIndex].title + ' · ' + sessions[sessionIndex].date : '暂无逐节课程'}}</view></picker><view class="muted small hint">体验课会占用该课程容量，但不会进入正式报名和扣课流水。</view></view><view class="field"><text class="field-label">班级</text><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="clubClass"><view class="picker">{{classes.length ? classes[classIndex].name : '请选择'}}</view></picker></view><view class="field"><text class="field-label">体验日期</text><picker mode="date" value="{{trialDate}}" bindchange="date"><view class="picker">{{trialDate}}</view></picker></view><view class="field"><text class="field-label">备注</text><textarea class="textarea" value="{{remark}}" bindinput="remark" placeholder="首次体验、家长关注点等"/></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">确认预约体验课</button></view>
