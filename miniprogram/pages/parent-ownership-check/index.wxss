.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;text-align:center}.summary view{display:flex;flex-direction:column}.summary text:first-child{font-size:42rpx;font-weight:700}.summary text:last-child{font-size:22rpx;color:#778079}.danger{color:#b42318}.safe{color:#07883f}.notice{margin:20rpx 0;padding:20rpx;background:#fff8e8;border-radius:16rpx;color:#765500}.safe-card{color:#07883f}.title{font-size:30rpx;font-weight:700}.binding{padding:18rpx 0;border-bottom:1rpx solid #edf0ee}.resolution{margin-top:18rpx;color:#b42318;font-weight:600}
