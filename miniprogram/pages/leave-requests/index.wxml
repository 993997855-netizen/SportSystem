<view class="page page-enter">
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
  <block wx:else><view class="section-title">请假记录</view><view class="card request" wx:for="{{requests}}" wx:key="id"><view class="between"><view><view class="name">{{item.student.name}}</view><view class="muted small meta">{{item.session.title}} · {{item.session.date}} {{item.session.time}}</view></view><view class="tag {{item.status === 'pending' ? 'gold' : ''}}">{{item.statusLabel}}</view></view><view class="reason">{{item.reason}}</view><view class="muted small">提交于 {{item.createdAt}}</view><view class="actions" wx:if="{{role !== 'parent' && item.status === 'pending'}}"><button size="mini" class="reject" data-id="{{item.id}}" data-approved="false" bindtap="review">拒绝</button><button size="mini" class="approve" data-id="{{item.id}}" data-approved="true" bindtap="review">同意并释放名额</button></view></view><view class="empty card" wx:if="{{requests.length === 0}}">暂无请假记录</view></block>
</view>
