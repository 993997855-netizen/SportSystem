<view class="page page-enter">
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
  <block wx:else><view class="section-title">请假记录</view><view class="card request" wx:for="{{requests}}" wx:key="id"><view class="between"><view><view class="name">{{item.student.name}}</view><view class="muted small meta">{{item.clubClass.name}} · {{item.session.title}}</view></view><view class="tag {{item.status === 'pending' ? 'gold' : item.status === 'rejected' ? 'danger' : ''}}">{{item.statusLabel}}</view></view><view class="detail"><text class="muted">课程时间</text><text>{{item.session.date}} {{item.session.time}}</text></view><view class="detail"><text class="muted">当前课时</text><text>{{item.student.remainingLessons}} 节</text></view><view class="reason">请假原因：{{item.reason}}</view><view class="muted small">提交于 {{item.submittedAt}}</view><view class="leave-tip" wx:if="{{item.status === 'approved'}}">本节课已记为请假，扣课0节；仍保留在应到名单中。</view><view class="actions" wx:if="{{role === 'admin' && item.status === 'pending'}}"><button size="mini" class="reject" data-id="{{item.id}}" data-approved="false" bindtap="review">拒绝</button><button size="mini" class="approve" data-id="{{item.id}}" data-approved="true" bindtap="review">批准请假</button></view><view class="actions" wx:if="{{role === 'parent' && item.status === 'pending'}}"><button size="mini" class="reject" data-id="{{item.id}}" bindtap="cancel">撤销请假</button></view></view><view class="empty card" wx:if="{{requests.length === 0}}">暂无请假记录</view></block>
</view>
