<view class="page page-enter"><view class="search"><input value="{{query}}" bindinput="field" confirm-type="search" bindconfirm="search" placeholder="搜索姓名、家长、手机号、出生年份或班级"/><button size="mini" bindtap="search">搜索</button></view><view class="hint">管理员可跨普通班与精英队人工添加；达到标准人数后会二次确认，但不会阻止添加。</view><view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="card student" wx:for="{{students}}" wx:key="id"><view class="grow"><view class="name">{{item.name}} <text class="tag">{{item.trainingLevel}}</text></view><view class="muted small">{{item.birthDate}} · {{item.guardianName}} {{item.guardianPhone}}</view><view class="muted small mt">当前：{{item.classNames || '未分班'}}</view><view class="muted small mt">剩余课时：{{item.remainingLessons}} 节</view></view><button size="mini" class="mini" data-id="{{item.id}}" loading="{{addingId === item.id}}" bindtap="add">加入本班</button></view><view class="empty card" wx:if="{{!loading && students.length === 0}}">没有匹配学员</view></view>
