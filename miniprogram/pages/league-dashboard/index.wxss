.league-hero{padding:34rpx;border-radius:28rpx;background:linear-gradient(145deg,#102f63,#28569a);color:#fff}.title{font-size:42rpx;font-weight:800;margin:10rpx 0}.headline{font-size:31rpx;font-weight:800}.next{margin-top:24rpx;padding:24rpx;border-radius:20rpx;background:#f4f6fa}.big{font-size:38rpx;font-weight:800;color:#173b77;margin:7rpx 0}.calendar{white-space:nowrap}.round-chip{display:inline-block;width:220rpx;margin-right:14rpx;padding:20rpx;border-radius:18rpx;background:#fff;line-height:1.7}.round-chip.active{background:#173b77;color:#fff}.round-chip text{display:block;font-size:20rpx;opacity:.7}.match{display:flex;gap:18rpx;align-items:center}.time{font-weight:800;color:#173b77}.vs{color:#d1a72f;font-weight:800;margin:0 8rpx}.score{font-size:32rpx;font-weight:800}.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.team{background:#fff;padding:22rpx;border-radius:18rpx}.team text{font-size:21rpx;color:#7a817d}.table-row{display:flex;justify-content:space-between;padding:20rpx 24rpx}.notice{margin-top:28rpx;padding:22rpx;border-radius:18rpx;background:#fff6da;color:#775b09;line-height:1.6}.create{display:inline-block;margin-top:22rpx}
