<view class="page">
  <view class="league-hero">
    <view class="eyebrow">NANLIAN SUNDAY GROWTH LEAGUE</view>
    <view class="title">南联周日成长联赛</view>
    <view class="sub">固定周日 · 以赛促练 · 成长有记录</view>
  </view>
  <view class="loading-state" wx:if="{{loading}}">加载中...</view>
  <block wx:else>
    <view class="card" wx:if="{{data.season}}">
      <view class="between">
        <view><view class="headline">{{data.season.name}}</view><view class="muted small">{{data.season.startDate}} 至 {{data.season.endDate}}</view></view>
        <view class="tag">{{data.season.status}}</view>
      </view>
      <view class="next" wx:if="{{data.nextRound}}">
        <view class="muted small">下一比赛日</view><view class="big">{{data.nextRound.date}}</view>
        <view>{{data.nextRound.birthYearsText}}组 · {{data.nextRound.venueId}}</view>
        <view class="muted small">第{{data.nextRound.roundNo}}轮 · {{data.nextRound.weekType === 'ODD' ? '单周' : '双周'}}</view>
      </view>
    </view>
    <view class="action-row" wx:if="{{role === 'admin'}}"><view class="action-chip" bindtap="season">创建赛季</view><view class="action-chip" bindtap="team">添加球队</view></view>
    <view class="section-title">比赛日历</view>
    <scroll-view class="calendar" scroll-x><view class="round-chip {{item.id === data.nextRound.id ? 'active' : ''}}" wx:for="{{data.rounds}}" wx:key="id" data-id="{{item.id}}" bindtap="round"><view>第{{item.roundNo}}轮</view><view>{{item.displayDate}}</view><view>{{item.birthYearsText}}组</view><text>{{item.status}}</text></view></scroll-view>
    <view class="section-title">下一轮对阵</view>
    <view class="card match" wx:for="{{data.matches}}" wx:key="id" data-id="{{item.id}}" bindtap="match"><view class="time">{{item.startTime}}</view><view class="grow"><view>{{item.homeTeam.name}} <text class="vs">VS</text> {{item.awayTeam.name}}</view><view class="muted small">{{item.venueId}}</view></view><view class="score" wx:if="{{item.status === 'FINISHED'}}">{{item.homeScore}}:{{item.awayScore}}</view></view>
    <view class="empty card" wx:if="{{data.matches.length === 0}}">本轮赛程尚未安排</view>
    <view class="section-title">参赛球队 · {{data.teams.length}}支</view>
    <view class="team-grid">
      <view class="team" wx:for="{{data.teams}}" wx:key="id">
        <view>{{item.name}}</view>
        <view class="team-coach" wx:if="{{item.coach.name}}"><image wx:if="{{item.coach.avatarUrl}}" src="{{item.coach.avatarUrl}}" mode="aspectFill" /><view wx:else class="coach-avatar-fallback">教</view><text>{{item.coach.name}}</text></view>
        <text>{{item.organizationType === 'INTERNAL' ? '南联内部' : '外部邀请'}}</text>
      </view>
    </view>
    <block wx:if="{{data.standingsVisible}}"><view class="section-title">积分统计</view><view class="card table-row" wx:for="{{data.standings}}" wx:key="teamId"><text>{{index + 1}}. {{item.teamName}}</text><text>{{item.played}}场 {{item.points}}分</text></view></block>
    <view class="notice">成长联赛默认不扣训练课时，不改变普通班或精英队关系，不设置自动候补。</view>
  </block>
</view>
