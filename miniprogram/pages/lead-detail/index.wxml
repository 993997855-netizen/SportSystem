<view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="page page-enter" wx:elif="{{lead}}"><view class="card"><view class="between"><view><view class="lead-name">{{lead.childName}} · {{lead.age}}岁</view><view class="muted small lead-meta">{{lead.gender}} · {{lead.school || '学校未登记'}} · {{lead.grade || '年级未登记'}}</view></view><view class="badge {{lead.intentionClass}}">{{lead.intentionLevel}}级</view></view><view class="divider"></view><view class="info"><text class="muted">家长</text><text>{{lead.parentName}}</text></view><view class="info"><text class="muted">电话</text><text>{{lead.mobile}}</text></view><view class="info"><text class="muted">微信</text><text>{{lead.wechat || '未登记'}}</text></view><view class="info"><text class="muted">来源</text><text>{{lead.source}}</text></view><view class="info"><text class="muted">负责人</text><text>{{lead.ownerCoachName || '公海'}}</text></view><view class="info"><text class="muted">意向课程</text><text>{{lead.interestedProgram || '未选择'}}</text></view><view class="info"><text class="muted">当前状态</text><text class="badge">{{lead.statusLabel}}</text></view><view class="action-row"><text class="action-chip" bindtap="phone">电话</text><text class="action-chip" bindtap="copyWechat">复制微信</text><text class="action-chip" bindtap="edit">编辑</text><text class="action-chip" wx:if="{{role === 'admin'}}" bindtap="assign">分配</text></view></view>
<view class="crm-nav-grid"><view class="crm-nav" data-url="/pages/followup-form/index" bindtap="go"><view class="crm-nav-title">＋ 添加跟进</view><view class="crm-nav-sub">保留完整沟通时间轴</view></view><view class="crm-nav" data-url="/pages/trial-form/index" bindtap="go"><view class="crm-nav-title">预约体验课</view><view class="crm-nav-sub">关联现有训练课程</view></view></view>
<view class="section-title">跟进时间轴</view><view class="card"><view class="timeline" wx:for="{{lead.followUps}}" wx:key="id"><view class="timeline-dot"></view><view class="between"><view class="timeline-title">{{item.method}} · {{item.result}}</view><text class="muted small">{{item.createdAt}}</text></view><view class="timeline-content">{{item.content}}</view><view class="muted small">跟进人：{{item.operatorName}}<text wx:if="{{item.nextFollowUpAt}}"> · 下次 {{item.nextFollowUpAt}}</text></view></view><view class="empty" wx:if="{{lead.followUps.length === 0}}">暂无跟进记录</view></view>
<view class="section-title">体验课记录</view><view class="card" wx:for="{{lead.trials}}" wx:key="id"><view class="between"><view class="lead-name">{{item.className || '体验课程'}}</view><view class="badge">{{item.statusLabel}}</view></view><view class="muted small lead-meta">{{item.trialDate}} · {{item.coachName}} · {{item.venueName}}</view><view class="timeline-content" wx:if="{{item.feedback && item.feedback.summary}}">{{item.feedback.summary}}</view><view class="action-row"><text class="action-chip feedback-btn" wx:if="{{item.attendanceStatus === 'present' || item.status === 'COMPLETED'}}" data-id="{{item.id}}" bindtap="feedback">填写/查看反馈</text><text class="action-chip danger" wx:if="{{item.status === 'SCHEDULED'}}" data-id="{{item.id}}" bindtap="cancelTrial">取消体验课</text></view></view><view class="empty card" wx:if="{{lead.trials.length === 0}}">暂无体验课记录</view>
<button class="btn-primary convert" wx:if="{{role === 'admin' && !lead.convertedStudentId}}" bindtap="convert">转为正式学员</button><view class="card won" wx:if="{{lead.convertedStudentId}}">已于 {{lead.convertedAt}} 转为正式学员</view><view class="action-row admin-actions" wx:if="{{role === 'admin' && !lead.convertedStudentId}}"><text class="action-chip" bindtap="publicPool">放入公海</text><text class="action-chip danger" bindtap="archive">归档线索</text></view></view>
