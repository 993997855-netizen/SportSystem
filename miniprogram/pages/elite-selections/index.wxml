<view class="page page-enter">
  <view class="hint">推荐记录永久保留。成长数据只作为人工判断参考，系统不会按分数自动晋升。</view>
  <view class="card between" wx:if="{{role === 'admin'}}"><view><view>批准后保留原普通班</view><view class="muted small">默认开启；关闭后原普通班关系会标记为已退出</view></view><switch checked="{{keepSource}}" bindchange="keep" color="#12643b"/></view>
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
  <view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
  <block wx:else><view class="card selection" wx:for="{{rows}}" wx:key="id"><view class="between"><view class="person"><image wx:if="{{item.student.avatarUrl}}" class="student-photo" src="{{item.student.avatarUrl}}" mode="aspectFill"/><view wx:else class="student-photo fallback">{{item.student.initial || '学'}}</view><view><view class="name">{{item.student.name}}</view><view class="muted small">{{item.student.birthDate}}</view></view></view><view class="tag {{item.status === 'APPROVED' ? '' : item.status === 'REJECTED' ? 'danger' : 'gold'}}">{{item.statusLabel}}</view></view><view class="muted small mt">{{item.fromClass.name || '直接选拔'}} → {{item.targetClass.name}}</view><view class="reason">{{item.recommendationReason}}</view><view class="muted small">推荐人：{{item.recommenderName}} · {{item.createdAt}}</view><view class="growth-link" data-student="{{item.student.id}}" bindtap="openGrowth">查看成长参考 ›</view><view class="actions" wx:if="{{role === 'admin' && item.status === 'PENDING'}}"><button size="mini" class="btn-secondary" data-id="{{item.id}}" data-approved="{{false}}" bindtap="review">暂不入选</button><button size="mini" class="btn-primary" loading="{{actingId === item.id}}" data-id="{{item.id}}" data-approved="{{true}}" bindtap="review">确认入队</button></view><view class="review" wx:if="{{item.reviewRemark}}">审核：{{item.reviewRemark}}</view></view><view class="empty card" wx:if="{{rows.length === 0}}">暂无推荐记录</view></block>
</view>
