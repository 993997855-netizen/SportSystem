<view class="page page-enter">
  <view class="hint">推荐记录永久保留。教练可查看自己提交的记录，管理员拥有最终审核权。</view>
  <view class="card between" wx:if="{{role === 'admin'}}"><view><view>批准后保留原普通班</view><view class="muted small">关闭后会将原班关系标记为已退出</view></view><switch checked="{{keepSource}}" bindchange="keep" color="#173B77"/></view>
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
  <view class="card selection" wx:for="{{rows}}" wx:key="id"><view class="between"><view class="name">{{item.student.name}}</view><view class="tag {{item.status === 'APPROVED' ? '' : item.status === 'REJECTED' ? 'danger' : 'gold'}}">{{item.statusLabel}}</view></view><view class="muted small mt">{{item.fromClass.name || '直接选拔'}} → {{item.targetClass.name}}</view><view class="reason">{{item.recommendationReason}}</view><view class="muted small">推荐人：{{item.recommenderName}} · {{item.createdAt}}</view><view class="actions" wx:if="{{role === 'admin' && item.status === 'PENDING'}}"><button size="mini" class="btn-secondary" data-id="{{item.id}}" data-approved="{{false}}" bindtap="review">暂不入选</button><button size="mini" class="btn-primary" data-id="{{item.id}}" data-approved="{{true}}" bindtap="review">确认入队</button></view><view class="review" wx:if="{{item.reviewRemark}}">审核：{{item.reviewRemark}}</view></view>
  <view class="empty card" wx:if="{{!loading && rows.length === 0}}">暂无推荐记录</view>
</view>
