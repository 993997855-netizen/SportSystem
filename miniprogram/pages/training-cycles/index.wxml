<view class="page"><view class="notice">教练每周提前填写训练主题和重点；周六会议讨论后，只需补充调整备注并确认。</view><button class="btn-primary" bindtap="add">制定本周训练计划</button><view class="error-state" wx:if="{{error}}">{{error}}</view><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="between"><view class="title">{{item.className}}</view><view class="tag">{{item.statusLabel}}</view></view><view class="muted small">{{item.coachName}} · {{item.weekStart}}—{{item.weekEnd}}</view><view class="primary">本周主题：{{item.mainTheme}}</view><view class="focus">{{item.focusText}}</view><view class="meeting" wx:if="{{item.meetingNote}}">会议调整：{{item.meetingNote}}</view></view><view class="empty card" wx:if="{{!loading && !rows.length}}">暂未制定周训练计划</view></view>
