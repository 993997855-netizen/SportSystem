<view class="page page-enter">
  <view class="search-card card"><view class="row"><input class="search grow" placeholder="孩子、家长或手机号" value="{{query}}" bindinput="query" confirm-type="search" bindconfirm="search"/><text class="search-btn" bindtap="search">搜索</text></view><view class="filters"><picker range="{{meta.statusOptions}}" range-key="label" bindchange="status"><view class="filter">{{statusLabel || '全部状态'}}</view></picker><picker range="{{meta.intentionOptions}}" bindchange="intention"><view class="filter">{{intentionLabel || '全部意向'}}</view></picker><picker range="{{meta.sourceOptions}}" bindchange="source"><view class="filter">{{sourceLabel || '全部来源'}}</view></picker><picker range="{{meta.coachOptions}}" range-key="name" bindchange="coach"><view class="filter">{{coachLabel || '全部负责人'}}</view></picker><picker range="{{sortOptions}}" bindchange="sort"><view class="filter">排序</view></picker></view><input class="search program-filter" placeholder="输入意向课程后点搜索" value="{{interestedProgram}}" bindinput="program"/><view class="filters date-filters"><picker mode="date" value="{{createdStart}}" bindchange="createdStart"><view class="filter">{{createdStart || '创建起始日'}}</view></picker><picker mode="date" value="{{createdEnd}}" bindchange="createdEnd"><view class="filter">{{createdEnd || '创建截止日'}}</view></picker></view></view>
  <view class="between list-head"><text class="muted small">共 {{rows.length}} 条</text><text class="brand-blue small" bindtap="add">＋新增线索</text></view>
  <block wx:for="{{rows}}" wx:key="id"><view class="section-title due-group-title" wx:if="{{item.showDueTitle}}">{{item.dueTitle}}</view><view class="card lead-card pressable" data-id="{{item.id}}" bindtap="detail"><view class="between"><view class="row"><view class="lead-name">{{item.childName}}</view><view class="badge {{item.intentionClass}} intention">{{item.intentionLevel}}级</view></view><view class="badge {{item.status === 'PUBLIC' ? 'public' : ''}}">{{item.statusLabel}}</view></view><view class="muted small lead-meta">{{item.age}}岁 · {{item.parentName}} {{item.mobile}}</view><view class="muted small lead-meta">{{item.interestedProgram || '未选课程'}} · {{item.source}} · {{item.ownerCoachName || '公海未分配'}}</view><view class="between follow"><text class="small {{item.overdue ? 'overdue' : 'muted'}}">{{item.nextFollowUpAt ? (item.overdue ? '已逾期 ' + item.overdueDays + ' 天' : '下次 ' + item.nextFollowUpAt) : '暂未安排跟进'}}</text><text class="small muted">跟进 {{item.followUpCount}} 次</text></view><button wx:if="{{view === 'public' && role === 'coach'}}" class="claim" data-id="{{item.id}}" catchtap="claim">领取线索</button></view></block>
  <view class="empty card" wx:if="{{!loading && rows.length === 0}}">暂无符合条件的线索</view><view class="loading-state" wx:if="{{loading}}">正在加载...</view>
  <floating-add-button bind:add="add" />
</view>

