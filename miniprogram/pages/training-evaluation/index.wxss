.hero{border-radius:28rpx;padding:32rpx}.title{font-size:38rpx;font-weight:800}.sub{color:#dce6f6;margin-top:10rpx}.batch{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;align-items:center}.student{display:flex;align-items:center;gap:16rpx}.avatar{width:68rpx;height:68rpx;background:#e6f3eb;color:#12643b;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800}.avatar.photo{object-fit:cover}.name{font-weight:750}.tags text{display:inline-block;font-size:19rpx;color:#12643b;background:#e9f5ee;padding:5rpx 9rpx;border-radius:99rpx;margin:6rpx 6rpx 0 0}
