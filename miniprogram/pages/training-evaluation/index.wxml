<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="page page-enter" wx:else><view class="hero brand-hero"><view class="title">{{session.title}}</view><view class="sub">快捷批量标签 + 个人详细评价</view></view><view class="card batch"><picker range="{{tags}}" value="{{tagIndex}}" bindchange="tag"><view class="picker">批量标签：{{tags[tagIndex]}} ›</view></picker><button class="btn-primary" loading="{{acting}}" bindtap="batch">添加给已选学员</button></view><checkbox-group bindchange="select"><label class="card student" wx:for="{{students}}" wx:key="id"><checkbox value="{{item.id}}" color="#12643b"/><image wx:if="{{item.avatarUrl}}" class="avatar photo" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{item.initial}}</view><view class="grow"><view class="name">{{item.name}}</view><view class="muted small">{{item.evaluation ? '已有评价，可继续修改' : '尚未评价'}}</view><view class="tags" wx:if="{{item.evaluation}}"><text wx:for="{{item.evaluation.tags}}" wx:key="*this">{{item}}</text></view></view><text class="link" data-student="{{item.id}}" catchtap="edit">详细评价 ›</text></label></checkbox-group></view>
