<view class="page"><view class="notice">该页面仅管理员可调用。每次查看和复制都会写入审计日志。</view><view class="card" wx:if="{{profile}}"><view class="info"><text class="muted">姓名</text><text>{{name}}</text></view><view class="info"><text class="muted">身份证号码</text><text>{{profile.idCardNumber || '未填写'}}</text></view><view class="info"><text class="muted">脱敏显示</text><text>{{profile.idCardMasked}}</text></view><button class="btn-primary" wx:if="{{profile.idCardNumber}}" bindtap="copy">复制身份证号码</button></view></view>
