.notice { color: #80561c; background: #fff3e2; border-radius: 18rpx; padding: 22rpx; font-size: 24rpx; line-height: 1.6; margin-bottom: 24rpx; }.name { font-size: 31rpx; font-weight: 700; }.mt { margin-top: 8rpx; }.lessons { font-size: 42rpx; color: #12643b; font-weight: 800; }.amount { font-size: 32rpx; font-weight: 700; }.confirm { margin-top: 24rpx; }
.blocked { color: #6d756f; line-height: 1.65; }.mask { position: fixed; inset: 0; background: rgba(0,0,0,.42); z-index: 10; animation: mask-in .2s ease-out both; }.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 11; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); animation: sheet-up .25s ease-out both; }.sheet-title { font-size: 34rpx; font-weight: 800; margin-bottom: 34rpx; }.close { font-size: 48rpx; color: #777; font-weight: 400; padding: 0 8rpx; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } } @keyframes sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
