.notice{color:#80561c;background:#fff3e2;border-radius:18rpx;padding:22rpx;font-size:24rpx;line-height:1.6;margin-bottom:20rpx}.admin-links{display:flex;gap:12rpx;margin-bottom:18rpx}.admin-links button{background:#173b77;color:#fff}.blocked{color:#677267}.alert{display:flex;align-items:center;gap:16rpx}.alert image,.fallback{width:72rpx;height:72rpx;border-radius:50%;flex:0 0 auto}.fallback{display:flex;align-items:center;justify-content:center;background:#e9f5ee;color:#12643b;font-weight:800}.name{font-size:30rpx;font-weight:800}.balance{font-size:30rpx;font-weight:800;color:#d97800}.empty-balance{color:#b53737}.picker-child{display:flex;justify-content:space-between}.order .amount{font-size:32rpx;font-weight:800;color:#173b77}.mt{margin-top:8rpx}.mask{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:10}.sheet{position:fixed;left:0;right:0;bottom:0;background:#fff;z-index:11;border-radius:30rpx 30rpx 0 0;padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));max-height:82vh;overflow:auto}.sheet-title{font-size:34rpx;font-weight:800;margin-bottom:26rpx}
.btn-primary{padding-left:18rpx;padding-right:18rpx;text-align:center;white-space:nowrap;letter-spacing:1rpx}
