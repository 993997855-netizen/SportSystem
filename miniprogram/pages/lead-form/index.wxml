<view class="page page-enter">
  <view class="card">
    <view class="field"><text class="field-label">孩子姓名 *</text><input class="input" value="{{lead.childName}}" data-key="childName" bindinput="field"/></view>
    <view class="field"><text class="field-label">性别</text><picker range="{{genders}}" value="{{genderIndex}}" bindchange="gender"><view class="picker">{{lead.gender}}</view></picker></view>
    <view class="field"><text class="field-label">出生日期</text><picker mode="date" value="{{lead.birthday}}" bindchange="birthday"><view class="picker">{{lead.birthday}}</view></picker></view>
    <view class="field"><text class="field-label">家长姓名 *</text><input class="input" value="{{lead.parentName}}" data-key="parentName" bindinput="field"/></view>
    <view class="field"><text class="field-label">联系电话 *</text><input class="input" type="number" maxlength="11" value="{{lead.mobile}}" data-key="mobile" bindinput="field"/></view>
    <view class="field"><text class="field-label">微信号</text><input class="input" value="{{lead.wechat}}" data-key="wechat" bindinput="field"/></view>
    <view class="field"><text class="field-label">学校 / 年级</text><input class="input" placeholder="学校" value="{{lead.school}}" data-key="school" bindinput="field"/><input class="input mt" placeholder="年级" value="{{lead.grade}}" data-key="grade" bindinput="field"/></view>
    <view class="field"><text class="field-label">意向课程</text><input class="input" value="{{lead.interestedProgram}}" data-key="interestedProgram" bindinput="field"/></view>
    <view class="field"><text class="field-label">信息来源 *</text><picker range="{{meta.sources}}" value="{{sourceIndex}}" bindchange="source"><view class="picker">{{lead.source}}</view></picker></view>
    <view class="field"><text class="field-label">意向等级</text><picker range="{{meta.intentions}}" value="{{intentionIndex}}" bindchange="intention"><view class="picker">{{lead.intentionLevel}}级</view></picker></view>
    <view class="field"><text class="field-label">负责人</text><picker range="{{meta.coaches}}" range-key="name" value="{{coachIndex}}" bindchange="coach"><view class="picker">{{lead.ownerCoachName || '暂不分配'}}</view></picker></view>
    <view class="field"><text class="field-label">备注</text><textarea class="textarea" value="{{lead.remark}}" data-key="remark" bindinput="field"/></view>
  </view>
  <button class="btn-primary" loading="{{saving}}" bindtap="save">保存线索</button>
</view>
