.card,.coach{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:16rpx}.title,.name{font-size:30rpx;font-weight:800}.muted{font-size:22rpx;color:#7a817d;margin-top:6rpx}.coach{display:flex;align-items:center;gap:16rpx}.coach image,.avatar{width:76rpx;height:76rpx;border-radius:50%;background:#e4f3ea;display:flex;align-items:center;justify-content:center;color:#08783f}.grow{flex:1}.reason{box-sizing:border-box;width:100%;min-height:140rpx;background:#fff;margin:24rpx 0;padding:22rpx;border-radius:18rpx}
