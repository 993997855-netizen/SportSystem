<view class="page"><view class="notice">训练大纲提供长期方向和参考，不自动生成或规定每节课程内容。</view><button wx:if="{{role === 'admin'}}" class="btn-primary" bindtap="add">新增训练大纲</button><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="between"><view class="title">{{item.name}}</view><view class="tag">{{item.ageGroup}} · {{item.classType === 'ELITE' ? '精英队' : '普通班'}}</view></view><view class="description">{{item.description}}</view><view><text class="objective" wx:for="{{item.topicNames}}" wx:key="*this">{{item}}</text></view></view></view>
