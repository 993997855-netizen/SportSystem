<view class="page"><view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view><block wx:else><view class="card"><view class="headline">第{{detail.round.roundNo}}轮 · {{detail.round.date}}</view><view class="muted">{{detail.round.weekType === 'ODD' ? '单周' : '双周'}} · {{birthYears}}年龄组</view><view class="tag {{detail.round.status === 'CANCELLED' ? 'danger' : ''}}">{{detail.round.status}}</view></view><view class="card" wx:if="{{role === 'admin'}}"><view class="field"><text class="field-label">比赛日期</text><picker mode="date" value="{{date}}" bindchange="date"><view class="picker">{{date}}</view></picker></view><view class="field"><text class="field-label">出生年份（可手工调整）</text><input class="input" value="{{birthYears}}" data-key="birthYears" bindinput="field"/></view><view class="field"><text class="field-label">场地</text><input class="input" value="{{venue}}" data-key="venue" bindinput="field"/></view><view class="action-row"><view class="action-chip" bindtap="update">保存调整</view><view class="action-chip" data-status="POSTPONED" bindtap="update">延期本轮</view><view class="action-chip danger" data-status="CANCELLED" bindtap="update">取消本轮</view><view class="action-chip" bindtap="generate">生成循环对阵</view></view></view><view class="section-title">本轮比赛</view><view class="card match" wx:for="{{detail.matches}}" wx:key="id" data-id="{{item.id}}" bindtap="match"><view>{{item.startTime}}</view><view class="grow">{{item.homeTeam.name}} vs {{item.awayTeam.name}}</view><view wx:if="{{item.status === 'FINISHED'}}">{{item.homeScore}}:{{item.awayScore}}</view></view><view class="empty card" wx:if="{{detail.matches.length === 0}}">{{role === 'parent' ? '当前孩子没有本轮比赛' : '暂无比赛，管理员可以生成循环对阵'}}</view></block></view>
